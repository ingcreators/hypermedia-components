{
  "name": "hypermedia-components",
  "private": true,
  "version": "0.0.0",
  "description": "Semantic components and recipes for hypermedia applications.",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
