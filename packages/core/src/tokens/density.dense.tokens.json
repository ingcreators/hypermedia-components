{
  "$description": "Dense density. Emitted under [data-density=\"dense\"]. Tightest of the three modes — most container paddings step down one notch from compact and small gaps land at 4 px.",
  "control": {
    "height":    { "$type": "dimension", "$value": "{primitive.size.control.xs}" },
    "padding-x": { "$type": "dimension", "$value": "{primitive.space.2}" }
  },
  "field": {
    "gap": { "$type": "dimension", "$value": "{primitive.space.1}" }
  },
  "toolbar": {
    "gap":       { "$type": "dimension", "$value": "{primitive.space.1}" },
    "padding-y": { "$type": "dimension", "$value": "{primitive.space.1}" },
    "padding-x": { "$type": "dimension", "$value": "0.375rem" }
  },
  "card": {
    "padding": { "$type": "dimension", "$value": "{primitive.space.2}" }
  },
  "dialog": {
    "padding": { "$type": "dimension", "$value": "{primitive.space.2}" },
    "gap":     { "$type": "dimension", "$value": "0.375rem" }
  },
  "popover": {
    "padding": { "$type": "dimension", "$value": "0.375rem" }
  },
  "alert": {
    "padding-block":  { "$type": "dimension", "$value": "0.375rem" },
    "padding-inline": { "$type": "dimension", "$value": "{primitive.space.2}" },
    "gap":            { "$type": "dimension", "$value": "{primitive.space.1}" }
  },
  "toast": {
    "padding-y": { "$type": "dimension", "$value": "0.375rem" },
    "padding-x": { "$type": "dimension", "$value": "{primitive.space.2}" },
    "gap":       { "$type": "dimension", "$value": "{primitive.space.1}" }
  },
  "table": {
    "cell-padding-y": { "$type": "dimension", "$value": "{primitive.space.1}" },
    "cell-padding-x": { "$type": "dimension", "$value": "0.375rem" }
  },
  "checkbox": {
    "size": { "$type": "dimension", "$value": "0.875rem" },
    "sm":   { "size": { "$type": "dimension", "$value": "0.75rem" } },
    "lg":   { "size": { "$type": "dimension", "$value": "1.125rem" } }
  },
  "radio": {
    "size": { "$type": "dimension", "$value": "0.875rem" },
    "sm":   { "size": { "$type": "dimension", "$value": "0.75rem" } },
    "lg":   { "size": { "$type": "dimension", "$value": "1.125rem" } }
  },
  "button": {
    "sm": {
      "height":    { "$type": "dimension", "$value": "24px" },
      "padding-x": { "$type": "dimension", "$value": "0.375rem" }
    },
    "lg": {
      "height":    { "$type": "dimension", "$value": "{primitive.size.control.sm}" },
      "padding-x": { "$type": "dimension", "$value": "{primitive.space.3}" }
    }
  },
  "input": {
    "sm": {
      "height":    { "$type": "dimension", "$value": "24px" },
      "padding-x": { "$type": "dimension", "$value": "0.375rem" }
    },
    "lg": {
      "height":    { "$type": "dimension", "$value": "{primitive.size.control.sm}" },
      "padding-x": { "$type": "dimension", "$value": "{primitive.space.3}" }
    }
  }
}
