{
  "$description": "Compact density. Emitted under [data-density=\"compact\"]. Overrides control sizes plus container paddings and gaps so the whole layout tightens together rather than just buttons / inputs.",
  "control": {
    "height":    { "$type": "dimension", "$value": "{primitive.size.control.sm}" },
    "padding-x": { "$type": "dimension", "$value": "{primitive.space.3}" }
  },
  "field": {
    "gap": { "$type": "dimension", "$value": "0.375rem" }
  },
  "toolbar": {
    "gap":       { "$type": "dimension", "$value": "0.375rem" },
    "padding-y": { "$type": "dimension", "$value": "0.375rem" },
    "padding-x": { "$type": "dimension", "$value": "{primitive.space.2}" }
  },
  "card": {
    "padding": { "$type": "dimension", "$value": "{primitive.space.3}" }
  },
  "dialog": {
    "padding": { "$type": "dimension", "$value": "{primitive.space.3}" },
    "gap":     { "$type": "dimension", "$value": "{primitive.space.2}" }
  },
  "popover": {
    "padding": { "$type": "dimension", "$value": "{primitive.space.2}" }
  },
  "alert": {
    "padding-block":  { "$type": "dimension", "$value": "{primitive.space.2}" },
    "padding-inline": { "$type": "dimension", "$value": "{primitive.space.3}" },
    "gap":            { "$type": "dimension", "$value": "0.375rem" }
  },
  "toast": {
    "padding-y": { "$type": "dimension", "$value": "{primitive.space.2}" },
    "padding-x": { "$type": "dimension", "$value": "{primitive.space.3}" },
    "gap":       { "$type": "dimension", "$value": "0.375rem" }
  },
  "table": {
    "cell-padding-y": { "$type": "dimension", "$value": "0.375rem" },
    "cell-padding-x": { "$type": "dimension", "$value": "{primitive.space.2}" }
  },
  "checkbox": {
    "size": { "$type": "dimension", "$value": "1rem" },
    "sm":   { "size": { "$type": "dimension", "$value": "0.75rem" } },
    "lg":   { "size": { "$type": "dimension", "$value": "1.25rem" } }
  },
  "radio": {
    "size": { "$type": "dimension", "$value": "1rem" },
    "sm":   { "size": { "$type": "dimension", "$value": "0.75rem" } },
    "lg":   { "size": { "$type": "dimension", "$value": "1.25rem" } }
  },
  "button": {
    "sm": {
      "height":    { "$type": "dimension", "$value": "{primitive.size.control.xs}" },
      "padding-x": { "$type": "dimension", "$value": "{primitive.space.2}" }
    },
    "lg": {
      "height":    { "$type": "dimension", "$value": "{primitive.size.control.md}" },
      "padding-x": { "$type": "dimension", "$value": "{primitive.space.4}" }
    }
  },
  "input": {
    "sm": {
      "height":    { "$type": "dimension", "$value": "{primitive.size.control.xs}" },
      "padding-x": { "$type": "dimension", "$value": "{primitive.space.2}" }
    },
    "lg": {
      "height":    { "$type": "dimension", "$value": "{primitive.size.control.md}" },
      "padding-x": { "$type": "dimension", "$value": "{primitive.space.4}" }
    }
  }
}
