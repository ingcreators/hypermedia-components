{
  "$description": "Emerald color theme. Emitted under [data-color=\"emerald\"]. Uses green.700 (not 600) as the primary so white text on the button clears WCAG AA (≈ 5.0:1) on both light and dark surfaces.",
  "color": {
    "focus-ring": { "$type": "color", "$value": "{primitive.color.green.500}" },
    "action": {
      "primary": {
        "bg":     { "$type": "color", "$value": "{primitive.color.green.700}" },
        "fg":     { "$type": "color", "$value": "{primitive.color.white}" },
        "border": { "$type": "color", "$value": "{primitive.color.green.700}" }
      },
      "primary-hover": {
        "bg":     { "$type": "color", "$value": "{primitive.color.green.800}" },
        "border": { "$type": "color", "$value": "{primitive.color.green.800}" }
      },
      "primary-soft": {
        "bg": { "$type": "color", "$value": "color-mix(in srgb, {primitive.color.green.700} 12%, transparent)" }
      }
    }
  }
}
