  "alert": {
    "padding-block":  { "$type": "dimension", "$value": "{semantic.space.3}" },
    "padding-inline": { "$type": "dimension", "$value": "{semantic.space.4}" },
    "radius":         { "$type": "dimension", "$value": "{semantic.control.radius}" },
    "gap":            { "$type": "dimension", "$value": "{semantic.space.2}" },
    "border-width":   { "$type": "dimension", "$value": "1px" },
    "title-weight":   { "$type": "fontWeight", "$value": "{semantic.font.weight-semibold}" },
