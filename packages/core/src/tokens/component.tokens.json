      "bg":     { "$type": "color", "$value": "{primitive.color.blue.50}" },
      "fg":     { "$type": "color", "$value": "{primitive.color.blue.800}" },
      "border": { "$type": "color", "$value": "{primitive.color.blue.100}" }
    },
    "success":  {
      "bg":     { "$type": "color", "$value": "{primitive.color.green.50}" },
      "fg":     { "$type": "color", "$value": "{primitive.color.green.800}" },
      "border": { "$type": "color", "$value": "{primitive.color.green.100}" }
    },
    "warning":  {
      "bg":     { "$type": "color", "$value": "{primitive.color.amber.50}" },
      "fg":     { "$type": "color", "$value": "{primitive.color.amber.800}" },
      "border": { "$type": "color", "$value": "{primitive.color.amber.100}" }
    },
    "danger":   {
      "bg":     { "$type": "color", "$value": "{primitive.color.red.50}" },
      "fg":     { "$type": "color", "$value": "{primitive.color.red.800}" },
      "border": { "$type": "color", "$value": "{primitive.color.red.100}" }
    }
