    "lg": {
      "height":     { "$type": "dimension", "$value": "{primitive.size.control.lg}" },
      "padding-x":  { "$type": "dimension", "$value": "{primitive.space.5}" },
      "font-size":  { "$type": "dimension", "$value": "{semantic.font.size-lg}" }
    }
  },
  "input": {
    "height":     { "$type": "dimension", "$value": "{semantic.control.height}" },
    "padding-x":  { "$type": "dimension", "$value": "{semantic.control.padding-x}" },
    "radius":     { "$type": "dimension", "$value": "{semantic.control.radius}" },
    "font-size":  { "$type": "dimension", "$value": "{semantic.font.size-md}" },
    "bg":         { "$type": "color", "$value": "{semantic.color.surface}" },
    "fg":         { "$type": "color", "$value": "{semantic.color.text}" },
    "border":     { "$type": "color", "$value": "{semantic.color.border}" },
    "placeholder": { "$type": "color", "$value": "{semantic.color.text-muted}" },
    "focus-border": { "$type": "color", "$value": "{semantic.color.focus-ring}" },
    "invalid-border": { "$type": "color", "$value": "{semantic.color.danger}" },
    "disabled-bg": { "$type": "color", "$value": "{primitive.color.gray.100}" },
    "sm": {
      "height":    { "$type": "dimension", "$value": "{primitive.size.control.sm}" },
      "padding-x": { "$type": "dimension", "$value": "{primitive.space.3}" },
      "font-size": { "$type": "dimension", "$value": "{semantic.font.size-sm}" }
    },
    "lg": {
      "height":    { "$type": "dimension", "$value": "{primitive.size.control.lg}" },
      "padding-x": { "$type": "dimension", "$value": "{primitive.space.5}" },
      "font-size": { "$type": "dimension", "$value": "{semantic.font.size-lg}" }
    }
  },
  "field": {
    "gap":            { "$type": "dimension",  "$value": "{semantic.space.2}" },
    "label-color":    { "$type": "color",      "$value": "{semantic.color.text}" },
