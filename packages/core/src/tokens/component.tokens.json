    "radius":       { "$type": "dimension",  "$value": "{semantic.control.radius}" },
    "font-size":    { "$type": "dimension",  "$value": "{semantic.font.size-sm}" },
    "font-weight":  { "$type": "fontWeight", "$value": "{semantic.font.weight-medium}" },
    "bg":           { "$type": "color",      "$value": "transparent" },
    "fg":           { "$type": "color",      "$value": "{semantic.color.text}" },
    "border":       { "$type": "color",      "$value": "transparent" },
    "hover-bg":     { "$type": "color",      "$value": "{primitive.color.gray.100}" },
    "current-bg":   { "$type": "color",      "$value": "{semantic.color.action.primary.bg}" },
