{
  "name": "@hypermedia-components/core",
  "version": "0.1.13",
  "description": "Semantic components and recipes for hypermedia applications.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ingcreators/hypermedia-components.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "dist/**/*.css",
    "./dist/hc.behaviors.js",
    "./dist/hc.behaviors.min.js",
    "./src/js/behaviors.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./min": {
      "types": "./dist/index.d.ts",
      "import": "./dist/hc.min.js"
    },
    "./i18n": {
      "types": "./dist/i18n.d.ts",
      "import": "./dist/i18n.js"
    },
    "./locales/*": {
      "types": "./dist/locales/*.d.ts",
      "import": "./dist/locales/*.js"
    },
    "./css": "./dist/hc.css",
    "./css/min": "./dist/hc.min.css",
    "./css/core": "./dist/hc.core.css",
    "./css/core/min": "./dist/hc.core.min.css",
    "./css/utilities": "./dist/hc.utilities.css",
    "./css/*": "./dist/hc-*.css",
    "./tokens.css": "./dist/hc.tokens.css",
    "./tokens.*.css": "./dist/hc.tokens.*.css",
    "./theme.css": "./dist/hc.theme.css",
    "./htmx.css": "./dist/hc.htmx.css",
    "./a11y.css": "./dist/hc.a11y.css",
    "./macros": {
      "types": "./dist/macros/index.d.ts",
      "import": "./dist/macros/index.js"
    },
    "./macros/min": "./dist/macros/index.min.js",
    "./behaviors": {
      "types": "./dist/hc.behaviors.d.ts",
      "import": "./dist/hc.behaviors.js"
    },
    "./behaviors/min": "./dist/hc.behaviors.min.js",
    "./tokens/*": "./src/tokens/*",
    "./token-transform": "./scripts/token-transform.mjs",
    "./email/*": "./src/email/*",
    "./email-transform": "./scripts/email-transform.mjs",
    "./manifest.json": "./dist/manifest.json",
    "./custom-elements.json": "./custom-elements.json"
  },
  "files": [
    "dist",
    "src/tokens",
    "src/email",
    "scripts/token-transform.mjs",
    "scripts/email-transform.mjs",
    "custom-elements.json"
  ],
  "scripts": {
    "build": "pnpm run build:tokens && pnpm run build:css && pnpm run build:types && pnpm run build:js && pnpm run build:min && pnpm run build:manifest",
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:css": "node scripts/bundle-css.mjs",
    "build:types": "tsc -p tsconfig.json",
    "build:js": "node scripts/bundle-js.mjs",
    "build:min": "node scripts/minify.mjs",
    "typecheck": "tsc -p tsconfig.smoke.json --noEmit",
    "test": "vitest run",
    "test:browser": "pnpm run build && playwright test",
    "lint": "pnpm run lint:js && pnpm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/css/**/*.css\"",
    "lint:fix": "eslint . --fix && stylelint \"src/css/**/*.css\" --fix",
    "build:manifest": "node scripts/build-manifest.mjs"
  },
  "keywords": [
    "hypermedia",
    "components",
    "htmx",
    "css",
    "design-tokens",
    "dtcg",
    "light-dom"
  ],
  "peerDependencies": {
    "@observablehq/plot": ">=0.6"
  },
  "peerDependenciesMeta": {
    "@observablehq/plot": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "customElements": "custom-elements.json"
}
