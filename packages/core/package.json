{
  "name": "@hypermedia-components/core",
  "version": "0.0.0",
  "description": "Semantic components and recipes for hypermedia applications.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ingcreators/hypermedia-components.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "dist/**/*.css",
    "./dist/hc.behaviors.js",
    "./src/js/behaviors.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": "./dist/hc.css",
    "./tokens.css": "./dist/hc.tokens.css",
    "./theme.css": "./dist/hc.theme.css",
    "./htmx.css": "./dist/hc.htmx.css",
    "./macros": {
      "types": "./dist/macros/index.d.ts",
      "import": "./dist/macros/index.js"
    },
    "./behaviors": {
      "types": "./dist/hc.behaviors.d.ts",
      "import": "./dist/hc.behaviors.js"
    },
    "./tokens/*": "./src/tokens/*"
  },
  "files": [
    "dist",
    "src/tokens"
  ],
  "scripts": {
    "build": "pnpm run build:tokens && pnpm run build:css && pnpm run build:types && pnpm run build:js",
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:css": "node scripts/bundle-css.mjs",
    "build:types": "tsc -p tsconfig.json",
    "build:js": "node scripts/bundle-js.mjs",
    "typecheck": "tsc -p tsconfig.smoke.json --noEmit",
    "test": "vitest run",
    "test:browser": "pnpm run build && playwright test",
    "lint": "pnpm run lint:js && pnpm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/css/**/*.css\""
  },
  "keywords": [
    "hypermedia",
    "components",
    "htmx",
    "css",
    "design-tokens",
    "dtcg",
    "light-dom"
  ],
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
