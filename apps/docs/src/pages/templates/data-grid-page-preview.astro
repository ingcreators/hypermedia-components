---
/*
 * Standalone, chrome-free preview of the data-grid page template.
 *
 * The template is about a screen that takes the whole viewport: the
 * chrome stays put and the grid takes what is left. Shown inside a
 * documentation column it is a picture of the idea, not the idea — so
 * it also gets a page of its own, at the size it is actually about.
 *
 * A plain Astro page, not a Starlight one: no sidebar, no header, no
 * content column. The core stylesheet and the behaviors bundle are
 * imported here the way Starlight's customCss / Head override do it
 * for the rest of the site.
 */
import '@hypermedia-components/core/css';
// The same two sheets Starlight loads through customCss — without them
// the shell's own chrome (sidebar links, preview canvas) renders raw.
import '../../styles/custom.css';
import '../../styles/preview.css';
import DataGridPageTemplateDemo from '../../components/template-demos/DataGridPageTemplateDemo.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<html lang="en" data-hc-base={base}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Data grid page — full-size preview | Hypermedia Components</title>
    <meta
      name="description"
      content="The data-grid page template at the size it is about: chrome fixed, only the grid scrolling." />
    <meta name="robots" content="noindex" />
    <script>
      import '@hypermedia-components/core/behaviors';

      // Coming back from a record: the list URL carried its conditions,
      // sort and page, so seed the grid's first request from them.
      // Without this, Back would land on an honest URL showing the
      // wrong answer — the exact defect the recipe warns about.
      const search = location.search.replace(/^\?/, '');
      if (search) {
        const rows = document.getElementById('template-grid-rows');
        const base = document.documentElement.dataset.hcBase ?? '';
        if (rows) {
          rows.setAttribute(
            'data-hx-get',
            `${base}/api/recipes/data-grid-page/items?${search}`,
          );
        }
      }
      // The screen is server-driven, so it needs htmx as much as the
      // recipe demos do. DemoFrame loads it for those; this page has no
      // DemoFrame, and without this line every data-hx-* attribute on
      // the template is inert — the grid stays empty and the chrome
      // shows its placeholder text, which is exactly what shipped.
      import htmx from 'htmx.org';
      window.htmx = htmx;

      // The same 422 / 409 / 401 allowance the recipe contracts
      // document and DemoFrame installs.
      document.body.addEventListener('htmx:beforeSwap', (event) => {
        const detail = event.detail;
        if ([401, 409, 422].includes(detail?.xhr?.status)) {
          detail.shouldSwap = true;
          detail.isError = false;
        }
      });
    </script>
    <style>
      html,
      body {
        margin: 0;
        block-size: 100%;
        background: var(--hc-color-bg);
        color: var(--hc-color-text);
        font-family: var(--hc-font-family-sans);
      }

      /* One line of chrome of our own: enough to get back, and small
         enough that the template still owns the viewport. */
      .preview-bar {
        position: fixed;
        inset-block-start: var(--hc-space-2);
        inset-inline-end: var(--hc-space-2);
        z-index: 10;
      }
    </style>
  </head>
  <body>
    <a class="hc-button preview-bar" data-size="sm" data-variant="secondary"
       href={`${base}/templates/data-grid-page/`}>↩ Back to the template page</a>
    <DataGridPageTemplateDemo standalone />
  </body>
</html>
