---
/*
 * Live preview for the data-grid page template — the layout every
 * business list screen wants: an hc-shell app frame, a page header,
 * a toolbar, and a datagrid that takes the remaining height so ONLY
 * the grid scrolls, under sticky multi-level headers and frozen
 * columns, with a filter panel in a dialog.
 *
 * Deliberately server-free: this preview is about the LAYOUT (what
 * scrolls, what stays), so the rows are static and the filter panel
 * does not round-trip. The wiring map on the page names the recipe
 * contracts each region's endpoint would implement.
 *
 * Ids are prefixed template-grid- because nothing here is a demo-API
 * fragment target.
 *
 * The kit ships no icon set (fundamentals/icons says why), so the
 * toolbar controls draw their own inline SVG in the Lucide idiom —
 * 24px grid, currentColor, 2px stroke. The POLICY is the point: icon +
 * label for anything not universal, icon-only for close / overflow /
 * pager chevrons, and a gear is NOT a columns icon (it reads as screen
 * settings and collides with them).
 */
import DemoFrame from '../recipe-demos/DemoFrame.astro';

const COLUMNS = [
  { key: 'ordered', label: 'Ordered on', group: 'Order' },
  { key: 'customer', label: 'Customer', group: 'Order' },
  { key: 'item', label: 'Item', group: 'Order' },
  { key: 'ship', label: 'Ship date', group: 'Shipment' },
  { key: 'carrier', label: 'Carrier', group: 'Shipment' },
  { key: 'qty', label: 'Quantity', group: 'Shipment', numeric: true },
  { key: 'amount', label: 'Amount', group: 'Shipment', numeric: true },
];

const CUSTOMERS = ['Northwind', 'Contoso', 'Fabrikam', 'Adventure Works'];
const CARRIERS = ['Road', 'Air', 'Sea'];
const ROWS = Array.from({ length: 40 }, (_, i) => ({
  id: 4901 + i,
  ordered: `2026-07-${String((i % 28) + 1).padStart(2, '0')}`,
  customer: CUSTOMERS[i % CUSTOMERS.length],
  item: `Bearing assembly ${1000 + i}`,
  ship: `2026-08-${String((i % 28) + 1).padStart(2, '0')}`,
  carrier: CARRIERS[i % CARRIERS.length],
  qty: (i % 9) * 12 + 6,
  amount: ((i % 9) * 12 + 6) * 145,
}));

const FILTERS = [
  { name: 'order', label: 'Order number' },
  { name: 'customer', label: 'Customer' },
  { name: 'item', label: 'Item code' },
  { name: 'carrier', label: 'Carrier' },
  { name: 'ship-to', label: 'Ship-to' },
  { name: 'buyer', label: 'Buyer' },
];
---

<DemoFrame label="Data grid page template">
  <div
    class="hc-shell"
    style="block-size: 36rem; --hc-shell-sidebar-width: 9rem; --hc-shell-pad: var(--hc-space-3);">
    <header class="hc-shell__header">
      <strong>Order desk</strong>
    </header>

    <nav class="hc-shell__sidebar" aria-label="Primary">
      <a href="#template-grid" aria-current="page">Orders</a>
      <a href="#template-grid">Shipments</a>
      <a href="#template-grid">Customers</a>
    </nav>

    <main class="hc-shell__main tpl-grid-main">
      <!-- The page column: fixed regions, then the grid taking the rest.
           Both minimums matter — see the stylesheet below. -->
      <div class="tpl-grid-page">
        <!-- Identity row. The heading names the SCREEN; the menu beside
             it names what is currently being looked at — the applied
             saved view — because that is the question a list screen is
             asked first and most often. Recall is navigation (a view is
             a named URL), so it lives here rather than three clicks deep
             inside the filter dialog. -->
        <div class="hc-cluster" style="justify-content: space-between;">
          <div class="hc-cluster">
            <h2 style="margin: 0; font-size: var(--hc-font-size-lg);">Orders</h2>
            <button
              class="hc-button"
              data-variant="ghost"
              type="button"
              id="template-grid-view-trigger"
              popovertarget="template-grid-views">
              <span>Overdue shipments</span>
              <span class="hc-badge" data-variant="warning">Modified</span>
              <span aria-hidden="true">▾</span>
            </button>

            <!-- Views are a radio set: exactly one is applied, and
                 "Show everything" is the none-of-them option — the way
                 back when a default view redirected the bare URL. Every
                 item is a real link, so views stay bookmarkable and
                 middle-clickable. -->
            <div
              class="hc-menu"
              id="template-grid-views"
              popover
              role="menu"
              aria-labelledby="template-grid-view-trigger">
              <div role="group" aria-labelledby="template-grid-views-pinned">
                <span class="hc-menu__label" id="template-grid-views-pinned">Pinned</span>
                <a class="hc-menu__item" role="menuitemradio" aria-checked="true"
                   href="#template-grid">Overdue shipments</a>
                <a class="hc-menu__item" role="menuitemradio" aria-checked="false"
                   href="#template-grid">Awaiting approval</a>
                <a class="hc-menu__item" role="menuitemradio" aria-checked="false"
                   href="#template-grid">Air freight — shared</a>
              </div>
              <hr class="hc-menu__separator" />
              <div role="group" aria-labelledby="template-grid-views-recent">
                <span class="hc-menu__label" id="template-grid-views-recent">Recent</span>
                <a class="hc-menu__item" role="menuitemradio" aria-checked="false"
                   href="#template-grid">Northwind backorders</a>
              </div>
              <hr class="hc-menu__separator" />
              <a class="hc-menu__item" role="menuitemradio" aria-checked="false"
                 href="#template-grid">Show everything</a>
              <hr class="hc-menu__separator" />
              <!-- Discarding a tweak is a NAVIGATION back to the view's
                   own URL — never a form reset, which would restore the
                   fields the server rendered, i.e. the modified state. -->
              <a class="hc-menu__item" role="menuitem" href="#template-grid">
                Reset to saved conditions
              </a>
              <a class="hc-menu__item" role="menuitem" href="#template-grid">Manage views…</a>
            </div>
          </div>
          <button
            class="hc-button"
            type="button"
            data-variant="secondary"
            onclick="document.getElementById('template-grid-filters').showModal()">
            <svg class="hc-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linejoin="round">
              <path d="M3 5h18l-7 8v6l-4 2v-8z" />
            </svg>
            Filters (3)
          </button>
        </div>

        <!-- The applied conditions: a control per condition, not decoration.
             The relative one shows the expression AND what it resolved
             to, and every remove link points at this URL minus that one
             param. -->
        <div class="hc-filterbar">
          <ul class="hc-filterbar__list">
            <li class="hc-filterbar__item">
              <button class="hc-filterbar__chip" type="button"
                      onclick="document.getElementById('template-grid-filters').showModal()">
                <span class="hc-filterbar__label">Ship date</span>
                <span class="hc-filterbar__op">from</span>
                <span class="hc-filterbar__value">start of this week (2026-08-10)</span>
              </button>
              <a class="hc-filterbar__remove" href="#template-grid"
                 aria-label="Remove Ship date filter">×</a>
            </li>
            <li class="hc-filterbar__item">
              <button class="hc-filterbar__chip" type="button"
                      onclick="document.getElementById('template-grid-filters').showModal()">
                <span class="hc-filterbar__label">Buyer code</span>
                <span class="hc-filterbar__op">is</span>
                <span class="hc-filterbar__value">3 values</span>
              </button>
              <a class="hc-filterbar__remove" href="#template-grid"
                 aria-label="Remove Buyer code filter">×</a>
            </li>
            <li class="hc-filterbar__item">
              <button class="hc-filterbar__chip" type="button"
                      onclick="document.getElementById('template-grid-filters').showModal()">
                <span class="hc-filterbar__label">Carrier</span>
                <span class="hc-filterbar__op">is</span>
                <span class="hc-filterbar__value">Road</span>
              </button>
              <a class="hc-filterbar__remove" href="#template-grid"
                 aria-label="Remove Carrier filter">×</a>
            </li>
          </ul>
          <a class="hc-filterbar__clear" href="#template-grid">Clear all</a>
        </div>

        <div class="hc-toolbar" role="toolbar" aria-label="Order actions">
          <!-- The sort control is a read-out first: with thirty columns
               the sorted one is usually scrolled out of view, so the
               header's aria-sort answers a question nobody can see.
               Header clicks stay the fast path. -->
          <button class="hc-button" data-variant="secondary" type="button"
                  id="template-grid-sort-trigger"
                  popovertarget="template-grid-sort">
            <svg class="hc-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round">
              <path d="M7 4v16M7 20l-3-3M7 20l3-3M17 20V4M17 4l-3 3M17 4l3 3" />
            </svg>
            Sort (2): Ship date ↓, Order ↑
          </button>
          <div class="hc-popover" id="template-grid-sort" popover
               aria-labelledby="template-grid-sort-trigger">
            <form action="#template-grid" method="get">
              <div class="hc-popover__body"
                   data-hc-close-popover-on-success="false">
                <ul class="hc-stack" data-hc-sortable data-hc-sort-list="sort">
                  <li class="hc-item" data-hc-sortable-id="ship" data-hc-sort-key="ship">
                    <button class="hc-button" data-variant="ghost" data-size="sm"
                            type="button" data-hc-sortable-handle
                            aria-label="Reorder Ship date">⠿</button>
                    <span class="hc-item__title">Ship date</span>
                    <select class="hc-select" data-size="sm" name="dir-ship"
                            aria-label="Ship date direction">
                      <option value="asc">Ascending</option>
                      <option value="desc" selected>Descending</option>
                    </select>
                  </li>
                  <li class="hc-item" data-hc-sortable-id="order" data-hc-sort-key="order">
                    <button class="hc-button" data-variant="ghost" data-size="sm"
                            type="button" data-hc-sortable-handle
                            aria-label="Reorder Order">⠿</button>
                    <span class="hc-item__title">Order</span>
                    <select class="hc-select" data-size="sm" name="dir-order"
                            aria-label="Order direction">
                      <option value="asc" selected>Ascending</option>
                      <option value="desc">Descending</option>
                    </select>
                  </li>
                </ul>
                <div class="hc-field">
                  <label class="hc-field__label" for="template-grid-sort-add">Add a column</label>
                  <select class="hc-select" id="template-grid-sort-add" name="add">
                    <option value="">Choose…</option>
                    <option value="customer">Customer</option>
                    <option value="amount">Amount</option>
                    <option value="warehouse">Warehouse (not shown)</option>
                  </select>
                </div>
              </div>
              <footer class="hc-popover__footer">
                <button class="hc-button" data-variant="primary" type="submit">Apply</button>
              </footer>
            </form>
          </div>
          <!-- The columns entry point. Without one the chooser exists
               and nobody can reach it — and a column set is a
               PREFERENCE (it follows the user between screens), so it
               is resolved URL → user preference → app default.
               The glyph is columns, NOT a gear: a gear reads as screen
               settings (density, theme) and collides with them. -->
          <button class="hc-button" data-variant="ghost" type="button"
                  id="template-grid-columns-trigger"
                  popovertarget="template-grid-columns">
            <svg class="hc-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="16" rx="2" />
              <path d="M9 4v16M15 4v16" />
            </svg>
            Columns (7 of 12)
          </button>
          <div class="hc-popover" id="template-grid-columns" popover
               aria-labelledby="template-grid-columns-trigger">
            <form action="#template-grid" method="get">
              <fieldset class="hc-popover__body" data-hc-sortable>
                <legend class="hc-field__label">Shown columns</legend>
                <label class="hc-checkbox-label">
                  <button class="hc-button" data-variant="ghost" data-size="sm"
                          type="button" data-hc-sortable-handle
                          aria-label="Reorder Ordered on">⠿</button>
                  <input class="hc-checkbox" type="checkbox" name="cols" value="ordered" checked />
                  Ordered on
                </label>
                <label class="hc-checkbox-label">
                  <button class="hc-button" data-variant="ghost" data-size="sm"
                          type="button" data-hc-sortable-handle
                          aria-label="Reorder Customer">⠿</button>
                  <input class="hc-checkbox" type="checkbox" name="cols" value="customer" checked />
                  Customer
                </label>
                <label class="hc-checkbox-label">
                  <button class="hc-button" data-variant="ghost" data-size="sm"
                          type="button" data-hc-sortable-handle
                          aria-label="Reorder Warehouse">⠿</button>
                  <input class="hc-checkbox" type="checkbox" name="cols" value="warehouse" />
                  Warehouse
                </label>
                <!-- …one row per column, the order serializing with it… -->
              </fieldset>
              <footer class="hc-popover__footer">
                <button class="hc-button" data-variant="primary" type="submit">Apply</button>
              </footer>
            </form>
          </div>
          <button class="hc-button" data-variant="ghost" type="button">Refresh</button>
          <a class="hc-button" data-variant="ghost"
             href="#template-grid?f-ship-from=@week-start&amp;f-carrier=road">Export 5,000 rows</a>
          <button class="hc-button" data-variant="ghost" type="button">Import</button>
          <hr role="separator" aria-orientation="vertical" />
          <div class="hc-button-group" role="group" aria-label="Approval">
            <button class="hc-button" data-variant="ghost" type="button">Approve</button>
            <button class="hc-button" data-variant="ghost" type="button">Reject</button>
          </div>
          <span data-hc-spacer="true"></span>
          <span aria-live="polite">4,901–4,940 of 5,000</span>
          <div class="hc-button-group" role="group" aria-label="Pages">
            <button class="hc-button" data-size="sm" type="button" aria-label="Previous page">‹</button>
            <button class="hc-button" data-size="sm" type="button" aria-label="Next page">›</button>
          </div>
        </div>

        <div class="hc-datagrid tpl-grid" id="template-grid" data-hc-zebra>
          <div class="hc-datagrid__scroll">
            <table class="hc-datagrid__table">
              <thead class="hc-datagrid__head">
                <tr>
                  <th class="hc-datagrid__headcell" data-frozen rowspan="2" scope="col"
                      style="--hc-datagrid-left: 0; inline-size: 2.5rem;">
                    <input type="checkbox" class="hc-checkbox" aria-label="Select all" />
                  </th>
                  <th class="hc-datagrid__headcell" data-frozen data-frozen-edge rowspan="2" scope="col"
                      style="--hc-datagrid-left: 2.5rem; inline-size: 6rem;">Order</th>
                  <th class="hc-datagrid__headcell" colspan="3">Order</th>
                  <th class="hc-datagrid__headcell" colspan="4">Shipment</th>
                </tr>
                <tr>
                  {COLUMNS.map((col) => (
                    <th
                      class="hc-datagrid__headcell"
                      scope="col"
                      data-numeric={col.numeric ? '' : undefined}>{col.label}</th>
                  ))}
                </tr>
              </thead>
              <tbody class="hc-datagrid__body">
                {ROWS.map((row) => (
                  <tr class="hc-datagrid__row" id={`template-grid-row-${row.id}`}>
                    <td class="hc-datagrid__cell" data-frozen style="--hc-datagrid-left: 0;">
                      <input type="checkbox" class="hc-checkbox" name="ids" value={row.id}
                             aria-label={`Select order ${row.id}`} />
                    </td>
                    <th class="hc-datagrid__cell" data-frozen data-frozen-edge scope="row"
                        style="--hc-datagrid-left: 2.5rem;">SO-{row.id}</th>
                    <td class="hc-datagrid__cell">{row.ordered}</td>
                    <td class="hc-datagrid__cell">{row.customer}</td>
                    <td class="hc-datagrid__cell">{row.item}</td>
                    <td class="hc-datagrid__cell" data-editable data-col="ship" data-value={row.ship}>{row.ship}</td>
                    <td class="hc-datagrid__cell">{row.carrier}</td>
                    <td class="hc-datagrid__cell" data-numeric>{row.qty}</td>
                    <td class="hc-datagrid__cell" data-numeric>{row.amount.toLocaleString('en-US')}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>

  <!-- The filter panel. One form wraps header, body and footer, so the
       footer's Search button submits the body's fields; the body is what
       scrolls when the panel outgrows the viewport. -->
  <dialog
    class="hc-dialog"
    id="template-grid-filters"
    aria-labelledby="template-grid-filters-title"
    style="--hc-dialog-max-width: 52rem;">
    <form method="get" action="#template-grid">
      <!-- The panel edits conditions and closes the composition by
           naming it. Recall left for the identity row above: switching
           views is navigation, and it was costing four interactions
           behind this dialog. What stays is the pair of terminal
           actions — and only those, so there is one undo (Cancel) and
           not two. -->
      <div class="hc-dialog__header">
        <div class="hc-cluster" style="justify-content: space-between;">
          <h2 class="hc-dialog__title" id="template-grid-filters-title">Filters</h2>
          <div class="hc-cluster">
            <button class="hc-button" data-size="sm" type="button">Update</button>
            <button class="hc-button" data-size="sm" type="button"
                    onclick="document.getElementById('template-grid-save-view').showModal()">Save as new…</button>
          </div>
        </div>
      </div>

      <div class="hc-dialog__body">
        <!-- data-align="start": a three-row textarea must not stretch
             its neighbour into a tall empty box. Labels stay ABOVE their
             control — faster to scan and to complete, and robust to
             label length, which a fixed label column is not. -->
        <div class="hc-grid" data-align="start" style="--hc-grid-min: 18rem;">
          {FILTERS.map((f) => (
            <div
              class="hc-field"
              data-applied={f.name === 'buyer' || f.name === 'carrier' ? '' : undefined}
              data-span={f.name === 'order' ? 'full' : undefined}>
              <label class="hc-field__label" for={`template-grid-f-${f.name}`}>{f.label}</label>
              {f.name === 'order' ? (
                <textarea class="hc-input" id={`template-grid-f-${f.name}`}
                          name={`f-${f.name}`} rows="3" data-hc-multi="lines"
                          placeholder="One per line — paste a column from a spreadsheet"></textarea>
              ) : (
                <div class="hc-input-group">
                  <input class="hc-input" type="text" id={`template-grid-f-${f.name}`} name={`f-${f.name}`} />
                  {/* The operator is SECONDARY: `equals` is what nearly
                      every row uses, so rendering it at the value's
                      weight doubles the cost of scanning for what is set. */}
                  <select class="hc-select" data-quiet name={`op-${f.name}`}
                          aria-label={`${f.label} operator`}>
                    <option value="eq">equals</option>
                    <option value="contains">contains</option>
                    <option value="starts">starts with</option>
                  </select>
                </div>
              )}
            </div>
          ))}

          {/* A period is one condition: one param (f-ship=A..B), one
              chip, one thing to remove. installRangeValue joins the
              pair on the way out; the names are the no-JS wire. */}
          <div class="hc-field" data-applied data-span="full">
            <span class="hc-field__label" id="template-grid-ship-label">Ship date</span>
            <div class="hc-cluster" role="group" aria-labelledby="template-grid-ship-label"
                 data-hc-range="f-ship">
              <input class="hc-input" type="date" name="f-ship-from" aria-label="Ship date from" />
              <span aria-hidden="true">–</span>
              <input class="hc-input" type="date" name="f-ship-to" aria-label="Ship date to" />
            </div>
          </div>

          <div class="hc-field">
            <label class="hc-field__label" for="template-grid-f-status">Status</label>
            <select class="hc-select" id="template-grid-f-status" name="f-status">
              <option value="">All</option>
              <option value="open">Open</option>
              <option value="shipped">Shipped</option>
              <option value="closed">Closed</option>
            </select>
          </div>
        </div>
      </div>

      <!-- One vocabulary: Apply here and Apply in the sort panel, never
           Search in one place and Apply in the other. Cancel is a native
           dialog submit — no inline JS, in a kit that advertises
           CSP-safety. -->
      <div class="hc-dialog__footer">
        <button class="hc-button" type="submit" formmethod="dialog">Cancel</button>
        <button class="hc-button" data-variant="primary" type="submit">Apply</button>
      </div>
    </form>
  </dialog>

  <!-- Saving asks three things, not one. Scope, because a department
       standard is the normal case and silently forking a colleague's
       view is an accident; default, because a screen that opens on the
       wrong question wastes a step every day (the bare list URL then
       303s here, so the address bar still shows the real conditions).
       Copy link sits beside Save because a view IS a URL. -->
  <dialog class="hc-dialog" id="template-grid-save-view"
          aria-labelledby="template-grid-save-view-title"
          style="--hc-dialog-max-width: 28rem;">
    <form method="post" action="/views">
      <div class="hc-dialog__header">
        <h2 class="hc-dialog__title" id="template-grid-save-view-title">Save view</h2>
      </div>

      <div class="hc-dialog__body">
        <div class="hc-stack">
          <div class="hc-field">
            <label class="hc-field__label" for="template-grid-view-name">Name</label>
            <input class="hc-input" id="template-grid-view-name" name="name"
                   value="Overdue shipments — Northwind" required />
          </div>

          <fieldset class="hc-field">
            <legend class="hc-field__label">Who can see it</legend>
            <label class="hc-radio-label">
              <input class="hc-radio" type="radio" name="scope" value="personal" checked />
              Only me
            </label>
            <label class="hc-radio-label">
              <input class="hc-radio" type="radio" name="scope" value="shared" />
              My team
            </label>
          </fieldset>

          <label class="hc-checkbox-label">
            <input class="hc-checkbox" type="checkbox" name="default" value="1" />
            Open this screen on it
          </label>

          <p class="hc-field__hint">
            Captures the conditions, the sort and the column set — not the
            page you are on.
          </p>
        </div>
      </div>

      <div class="hc-dialog__footer">
        <button class="hc-button" data-variant="ghost" type="button"
                style="margin-inline-end: auto;"
                data-hc-copy-text="https://orders.example.com/orders?f-ship=@week-start..&amp;f-carrier=road&amp;sort=-ship,order"
                aria-label="Copy a link to these conditions">Copy link</button>
        <button class="hc-button" type="submit" formmethod="dialog">Cancel</button>
        <button class="hc-button" data-variant="primary" type="submit">Save</button>
      </div>
    </form>
  </dialog>
</DemoFrame>

<style>
  /* The page column inside hc-shell__main. BOTH minimums are needed:
     a flex item will not shrink below its content on either axis, and
     the datagrid's max-content table is very wide. Without
     min-inline-size the column grows to the table's width and
     hc-shell__main scrolls horizontally — carrying the toolbar and the
     title with it, which is exactly what the grid's own scrollport is
     supposed to prevent. */
  .tpl-grid-main {
    display: flex;
    min-block-size: 0;
    min-inline-size: 0;
  }

  .tpl-grid-page {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-block-size: 0;
    min-inline-size: 0;
    gap: var(--hc-space-3);
  }

  .tpl-grid {
    flex: 1;
    min-block-size: 0;
    min-inline-size: 0;

    --hc-datagrid-max-height: 100%;
  }

  /* Below hc-shell's own breakpoint the shell becomes an ordinary
     scrolling page (display: block, overflow: visible) — by design. The
     grid then has no definite parent height, so `100%` caps nothing and
     it would render every row. Fall back to the viewport cap. */
  @media (width <= 60rem) {
    .tpl-grid {
      --hc-datagrid-max-height: 70vh;
    }
  }
</style>
