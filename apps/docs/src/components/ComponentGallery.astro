---
/*
 * ComponentGallery — a visual index of every component, grouped by the
 * same categories as the sidebar. Each card pulls its title + one-line
 * blurb from the target page's own frontmatter (via the `docs`
 * collection), so the gallery never drifts out of sync. Dogfoods
 * hc-grid + hc-card.
 */
import { getCollection } from 'astro:content';

const CATEGORIES = [
  { label: 'Actions', items: ['button', 'button-group', 'toggle-group', 'toolbar', 'command', 'kbd'] },
  { label: 'Forms', items: ['field', 'input', 'input-group', 'inputotp', 'select', 'combobox', 'multicombobox', 'checkbox', 'radio', 'switch', 'slider', 'rating', 'range', 'datepicker', 'calendar', 'dropzone', 'attachment'] },
  { label: 'Navigation', items: ['breadcrumb', 'toc', 'pagination', 'stepper', 'tabs', 'menu', 'menubar', 'navmenu', 'context-menu', 'tree'] },
  { label: 'Overlays', items: ['dialog', 'drawer', 'popover', 'hovercard', 'tooltip'] },
  { label: 'Data display', items: ['table', 'code', 'datagrid', 'card', 'item', 'avatar', 'badge', 'chip', 'separator', 'accordion', 'collapsible', 'sparkline', 'timeline', 'chat'] },
  { label: 'Feedback', items: ['alert', 'toast', 'progress', 'meter', 'spinner', 'skeleton', 'empty'] },
  { label: 'Layout', items: ['aspect', 'scroll-area', 'shell', 'splitter', 'carousel'] },
];

const docs = await getCollection('docs');
const byId = new Map(docs.map((e) => [e.id, e]));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// When embedded on a /ja/ page, pull the ja entries (card title +
// blurb) and link to the /ja/ routes; fall back to the English entry
// so a not-yet-translated page still gets a card (its /ja/ route
// exists via Starlight's locale fallback).
const isJa = Astro.url.pathname.includes('/ja/');
const idPrefix = isJa ? 'ja/' : '';
const linkBase = isJa ? `${base}/ja` : base;
const anchor = (label) => label.toLowerCase().replace(/\s+/g, '-');
---

{
  CATEGORIES.map((cat) => (
    <section class="hc-gallery__section">
      <h2 id={anchor(cat.label)}>{cat.label}</h2>
      <div class="hc-grid not-content" style="--hc-grid-min: 15rem;">
        {cat.items.map((name) => {
          const entry = byId.get(`${idPrefix}components/${name}`) ?? byId.get(`components/${name}`);
          if (!entry) return null;
          return (
            <a class="hc-card hc-gallery__card" href={`${linkBase}/components/${name}/`}>
              <div class="hc-card__header">
                <strong>{entry.data.title}</strong>
              </div>
              <div class="hc-card__body">{entry.data.description}</div>
            </a>
          );
        })}
      </div>
    </section>
  ))
}

<style>
  .hc-gallery__section {
    margin-block-start: 2rem;
  }

  .hc-gallery__card {
    display: block;
    text-decoration: none;
    color: inherit;
    transition:
      border-color 120ms ease,
      box-shadow 120ms ease;
  }

  .hc-gallery__card:hover {
    border-color: var(--hc-color-action-primary-bg);
    box-shadow: 0 2px 10px rgb(0 0 0 / 8%);
  }

  .hc-gallery__card .hc-card__body {
    color: var(--hc-color-text-muted);
    font-size: 0.875rem;
    line-height: 1.45;
  }
</style>
