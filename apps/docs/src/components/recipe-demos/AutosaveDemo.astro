---
/*
 * Live demo for the autosave recipe. Type in the title and pause —
 * after the 2 s debounce the draft posts and the status line stamps.
 * Save posts the record (and the dirty guard turns clean); the draft
 * status keeps its own life. Stateless demo API — see
 * apps/docs/demo-api/recipes/autosave.mjs.
 */
import DemoFrame from './DemoFrame.astro';

const api = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/api/recipes/autosave`;
---

<DemoFrame class="hc-preview--col" label="Autosave demo">
  <form id="autosave-demo-report" class="hc-stack" data-hc-dirty-guard
        data-hx-post={`${api}/reports/42`}
        data-hx-target="#autosave-demo-status" data-hx-swap="innerHTML">
    <div class="hc-field">
      <label class="hc-field__label" for="autosave-demo-title">Title</label>
      <input class="hc-input" id="autosave-demo-title" name="title"
             value="Quarterly report">
    </div>

    <div data-hx-post={`${api}/reports/42/draft`}
         data-hx-include="closest form"
         data-hx-trigger="input from:closest form changed delay:2s"
         data-hx-target="#autosave-demo-draft-status" data-hx-swap="innerHTML">
    </div>
    <p class="hc-field__hint" id="autosave-demo-draft-status" aria-live="polite">
      Type in the title, then pause two seconds.
    </p>

    <p class="hc-field__hint" id="autosave-demo-status" aria-live="polite"></p>
    <button class="hc-button" data-variant="primary" type="submit">Save</button>
  </form>
</DemoFrame>
