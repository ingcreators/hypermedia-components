---
/*
 * Live demo shared by the chat-messages AND streaming-response recipe
 * pages — one composed exchange: the composer POST (chat-messages
 * contract) appends the user <li> and the aria-busy assistant
 * placeholder, and the placeholder then owns its own SSE connection
 * (streaming-response contract) until `done`/`error`/stop swap it
 * away. Both halves talk to the same demo namespace,
 * `api/recipes/chat-messages/`.
 *
 * `variant="attachments"` renders the second instance documented under
 * the chat-messages page's "Attachments" section: its own transcript
 * and a multipart composer (both encodings + file input + the
 * htmx-indicator progress bar that installUploadProgress(), auto-init,
 * drives). A hidden `demo=attach` field keys the handler onto the
 * `chat-messages-attach-demo-*` id prefix so the two demos never
 * cross.
 *
 * The composer below manually mirrors composerHtml() in
 * apps/docs/demo-api/recipes/chat-messages.mjs (the OOB re-renders the
 * server returns must replace THIS form) — keep ids and attributes in
 * sync for both variants. `installChatScroll()` (auto-init, loaded by
 * Head.astro) pins the list to the bottom and wires the jump button.
 */
import DemoFrame from './DemoFrame.astro';

const api = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/api/recipes/chat-messages`;

const { variant = 'default' } = Astro.props;
const attach = variant === 'attachments';
const prefix = attach ? 'chat-messages-attach-demo' : 'chat-messages-demo';
---

<DemoFrame class="hc-preview--col" label={attach ? 'Chat attachments demo' : 'Chat demo'}>
  <div class="hc-chat" role="log" aria-label="Conversation" style="inline-size: 100%;">
    <ol
      class="hc-chat__list"
      tabindex="0"
      id={`${prefix}-list`}
      style="max-block-size: 20rem;">
      <li class="hc-chat__message" data-role="assistant">
        <div class="hc-chat__body">
          {
            attach
              ? 'Hi! Attach a file (1 MB or smaller), add a message if you like, and send — the attachment card is echoed inside your message.'
              : 'Hi! Send a message and I will stream back a canned reply. Include the word “fail” to watch the error path instead.'
          }
        </div>
      </li>
    </ol>
    <button class="hc-chat__jump hc-button" data-size="sm" type="button">↓ Latest</button>

    <form
      class="hc-field"
      id={`${prefix}-composer`}
      method="post"
      action={`${api}/chat/messages`}
      enctype={attach ? 'multipart/form-data' : undefined}
      data-hx-post={`${api}/chat/messages`}
      data-hx-encoding={attach ? 'multipart/form-data' : undefined}
      data-hx-target={`#${prefix}-list`}
      data-hx-swap="beforeend"
      data-hx-disabled-elt="find button[type=submit]"
      data-hx-indicator={attach ? 'find progress' : undefined}>
      {attach && <input type="hidden" name="demo" value="attach" />}
      <label class="hc-field__label" for={`${prefix}-prompt`}>Message</label>
      <textarea
        class="hc-input"
        id={`${prefix}-prompt`}
        name="prompt"
        rows="2"></textarea>
      {
        attach && (
          <>
            <label class="hc-field__label" for={`${prefix}-file`}>
              Attachment
            </label>
            <input class="hc-input" id={`${prefix}-file`} name="attachment" type="file" />
            <progress
              class="hc-progress htmx-indicator"
              data-hc-upload-progress
              value="0"
              max="100"
              aria-label="Upload progress"
            />
          </>
        )
      }
      <button class="hc-button" data-variant="primary" type="submit">Send</button>
    </form>
  </div>
</DemoFrame>
