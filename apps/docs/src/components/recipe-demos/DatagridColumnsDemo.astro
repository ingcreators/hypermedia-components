---
/*
 * Live demo for the datagrid-columns recipe. Same shape as
 * recipes/datagrid-columns/recipe.html, pointed at the demo API
 * namespace (a real app would use its own grid URL such as `/items`).
 * The grid wrapper loads the default columns on first paint; Apply
 * GETs the same URL with repeated cols= params, and the server answers
 * the grid fragment plus an out-of-band re-render of the chooser with
 * matching checked states — no client column hiding.
 */
import DemoFrame from './DemoFrame.astro';

const api = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/api/recipes/datagrid-columns`;
---

<DemoFrame class="hc-preview--col" label="Datagrid columns demo">
  <button
    class="hc-button"
    type="button"
    popovertarget="datagrid-columns-demo-popover"
    aria-expanded="false">
    Columns
  </button>

  <div id="datagrid-columns-demo-popover" class="hc-popover" popover>
    <form
      id="datagrid-columns-demo-chooser"
      action={`${api}/items`}
      method="get"
      data-hx-get={`${api}/items`}
      data-hx-target="#datagrid-columns-demo-grid"
      data-hc-close-popover-on-success>
      <fieldset class="hc-popover__body" id="datagrid-columns-demo-fields" data-hc-sortable>
      <label class="hc-checkbox-label">
        <button type="button" class="hc-button" data-variant="ghost" data-hc-sortable-handle>⠿</button>
        <input class="hc-checkbox" type="checkbox" name="cols" value="name" checked />
        Name
      </label>
      <label class="hc-checkbox-label">
        <button type="button" class="hc-button" data-variant="ghost" data-hc-sortable-handle>⠿</button>
        <input class="hc-checkbox" type="checkbox" name="cols" value="status" checked />
        Status
      </label>
      <label class="hc-checkbox-label">
        <button type="button" class="hc-button" data-variant="ghost" data-hc-sortable-handle>⠿</button>
        <input class="hc-checkbox" type="checkbox" name="cols" value="owner" checked />
        Owner
      </label>
      <label class="hc-checkbox-label">
        <button type="button" class="hc-button" data-variant="ghost" data-hc-sortable-handle>⠿</button>
        <input class="hc-checkbox" type="checkbox" name="cols" value="updated" checked />
        Updated
      </label>
      </fieldset>
      <footer class="hc-popover__footer">
        <button class="hc-button" type="submit" data-variant="primary">Apply</button>
      </footer>
    </form>
  </div>

  <div
    class="hc-datagrid"
    id="datagrid-columns-demo-grid"
    data-hx-get={`${api}/items`}
    data-hx-trigger="load"
    data-hx-swap="innerHTML">
  </div>
</DemoFrame>
