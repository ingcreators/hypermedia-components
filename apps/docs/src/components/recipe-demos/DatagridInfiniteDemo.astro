---
/*
 * Live demo for the datagrid-infinite recipe — the CONTAINER-SCROLLED
 * variant. The grid keeps its own scrollbar (a height cap), so each
 * sentinel triggers on `intersect once root:#datagrid-infinite-demo-scroll`
 * (IntersectionObserver, container-aware) rather than the contract's
 * window-viewport `revealed`.
 *
 * Why: `revealed` measures the WINDOW. With only 15 demo rows, a tall
 * screen has the fresh sentinel already in view, so it chain-loads the
 * whole list before the reader ever scrolls — the demo would show a
 * full table instead of infinite scrolling. Real page-scrolled feeds
 * (the recipe's default shape) keep `revealed`; the contract documents
 * this carve-out.
 */
import DemoFrame from './DemoFrame.astro';

const api = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/api/recipes/datagrid-infinite`;
---

<DemoFrame class="hc-preview--col" label="Datagrid infinite scroll demo">
  <div class="hc-datagrid" style="--hc-datagrid-max-height: 260px;">
    <div class="hc-datagrid__scroll" id="datagrid-infinite-demo-scroll">
      <table class="hc-datagrid__table">
        <thead class="hc-datagrid__head">
          <tr>
            <th class="hc-datagrid__headcell" scope="col">ID</th>
            <th class="hc-datagrid__headcell" scope="col">Product</th>
            <th class="hc-datagrid__headcell" scope="col">Price</th>
            <th class="hc-datagrid__headcell" scope="col">Stock</th>
          </tr>
        </thead>
        <tbody
          class="hc-datagrid__body"
          id="datagrid-infinite-demo-rows"
          data-hx-get={`${api}/items`}
          data-hx-trigger="load"
          data-hx-swap="innerHTML">
        </tbody>
      </table>
    </div>
  </div>
</DemoFrame>
