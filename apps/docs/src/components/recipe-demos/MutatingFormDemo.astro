---
/*
 * Live demo for the mutating-form recipe. Same create-member form as
 * recipes/mutating-form/expanded.html, pointed at the demo API
 * namespace (a real app would use its own URL such as `/members`).
 * `required` is omitted so the server-side `required` error can be
 * demoed. A successful submit navigates the whole window to the
 * demo's landing page via HX-Redirect — that IS the contract.
 */
import DemoFrame from './DemoFrame.astro';

const api = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/api/recipes/mutating-form`;
---

<DemoFrame class="hc-preview--col" label="Mutating form demo">
  <form
    method="post"
    action={`${api}/members`}
    data-hx-post={`${api}/members`}
    data-hx-target="#mutating-form-demo-errors"
    data-hx-swap="innerHTML"
    data-hx-disabled-elt="find button[type=submit]"
    data-hx-indicator="find .hc-spinner">
    <div id="mutating-form-demo-errors"></div>

    <div class="hc-field">
      <label class="hc-field__label" for="mutating-form-demo-email">Email</label>
      <input
        class="hc-input"
        id="mutating-form-demo-email"
        name="email"
        type="email"
        autocomplete="off" />
    </div>

    <div class="hc-field">
      <label class="hc-field__label" for="mutating-form-demo-display-name">
        Display name
      </label>
      <input
        class="hc-input"
        id="mutating-form-demo-display-name"
        name="display_name"
        type="text"
        autocomplete="off" />
    </div>

    <span class="hc-action">
      <button class="hc-button" data-variant="primary" type="submit">Create</button>
      <span class="hc-spinner htmx-indicator" aria-hidden="true"></span>
    </span>
  </form>
</DemoFrame>
