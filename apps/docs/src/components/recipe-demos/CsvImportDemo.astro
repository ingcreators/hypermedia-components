---
/*
 * Live demo for the csv-import recipe. Same shape as
 * recipes/csv-import/recipe.html, pointed at the demo API namespace.
 * Uploading only validates: the report (summary + error table + the
 * tokened confirm form) lands in the report slot, and committing the
 * token replaces it with the result summary + a toast. The demo API is
 * stateless (the live-demos doctrine): its token IS the validated
 * batch (base64url of the valid rows) — a real app holds the batch
 * server-side and the token merely references it; see the docblock in
 * apps/docs/demo-api/recipes/csv-import.mjs.
 */
import DemoFrame from './DemoFrame.astro';

const api = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/api/recipes/csv-import`;
---

<DemoFrame class="hc-preview--col" label="CSV import demo">
  <form
    id="csv-import-demo-form"
    method="post"
    action={`${api}/imports`}
    enctype="multipart/form-data"
    data-hx-post={`${api}/imports`}
    data-hx-encoding="multipart/form-data"
    data-hx-target="#csv-import-demo-report"
    data-hx-indicator="find progress"
    data-hx-disabled-elt="find button[type=submit]">
    <div class="hc-field">
      <label class="hc-field__label" for="csv-import-demo-csv">CSV file</label>
      <input
        class="hc-input"
        id="csv-import-demo-csv"
        name="csv"
        type="file"
        required
        accept=".csv,text/csv" />
    </div>

    <progress
      class="hc-progress htmx-indicator"
      data-hc-upload-progress
      value="0"
      max="100"
      aria-label="Upload progress">
    </progress>

    <button class="hc-button" data-variant="primary" type="submit">Upload</button>
  </form>

  <div id="csv-import-demo-report" aria-live="polite">
    <p class="hc-field__message">
      Upload a name,qty CSV — the report shows what would be imported
      before anything happens.
    </p>
  </div>
</DemoFrame>
