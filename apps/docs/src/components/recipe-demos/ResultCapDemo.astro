---
/*
 * Live demo for the result-cap recipe. An ordinary search form (the
 * live-search shape) pointed at a demo endpoint with a deliberately
 * tiny cap of 25: the empty search truncates, so the banner shows
 * immediately; typing narrows under the cap and the banner leaves
 * with the truncation it described. The mode select switches the
 * server between the contract's truncate and hard-reject branches.
 * Server side: apps/docs/demo-api/recipes/result-cap.mjs.
 */
import DemoFrame from './DemoFrame.astro';

const api = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/api/recipes/result-cap`;
---

<DemoFrame class="hc-preview--col" label="Result cap demo">
  <form class="hc-cluster" action={`${api}/orders`} method="get" role="search">
    <input
      class="hc-input"
      type="search"
      name="q"
      placeholder="Search 90 orders (cap: 25)"
      aria-label="Search orders"
      data-hx-get={`${api}/orders`}
      data-hx-trigger="input changed delay:300ms, search"
      data-hx-include="closest form"
      data-hx-target="#result-cap-demo-results"
      data-hx-swap="innerHTML"
      data-hx-sync="closest form:replace" />
    <label class="hc-field" style="flex-direction: row; align-items: center; gap: 0.5rem;">
      <span class="hc-field__label" style="margin: 0;">Over the cap</span>
      <select
        class="hc-select"
        name="mode"
        data-hx-get={`${api}/orders`}
        data-hx-include="closest form"
        data-hx-target="#result-cap-demo-results"
        data-hx-swap="innerHTML">
        <option value="truncate" selected>truncate (banner)</option>
        <option value="reject">hard reject</option>
      </select>
    </label>
    <button class="hc-button" type="submit">Search</button>
  </form>

  <div
    id="result-cap-demo-results"
    data-hx-get={`${api}/orders`}
    data-hx-trigger="load"
    data-hx-swap="innerHTML">
  </div>
</DemoFrame>
