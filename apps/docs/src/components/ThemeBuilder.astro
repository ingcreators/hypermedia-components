---
// Interactive theme builder for the docs.
//
// Generates custom themes by reusing the REAL token transformer
// (`@hypermedia-components/core/token-transform`) fed with the REAL DTCG
// sources, so the preview, "apply to page", and every export are produced
// by the same `buildTokensCss` the library build uses — always correct,
// subtree-safe, and never bypassing the "DTCG sources → generated CSS
// variables" model.
//
// Two modes:
//   - Accent: a new `[data-color="<name>"]` axis (additive, opt-in).
//   - Full theme: customise the default look — accent + neutral ramp +
//     control radius across light AND dark. Output is computed as the diff
//     of (themed full build) vs (stock full build), so it captures exactly
//     the changed variables in every block.
//
// Exports: DTCG source(s), an additive CSS block, a full token CSS, and
// theme-baked HTML email templates (Thymeleaf natural-template or plain
// flavor) generated from the same resolved tokens via
// `@hypermedia-components/core/email-transform`.
//
// Full theme also offers typography (body / heading / mono font-family). The
// first option in each list is the stock stack, so "System" is a no-op (no
// diff). HC ships no webfonts — the builder only sets the font-family var;
// load the chosen face yourself or it falls back down the stack.

const SANS = "system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif";
const MONO = "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace";

const BODY_FONTS = [
  { label: 'System', value: SANS },
  { label: 'Inter', value: "Inter, system-ui, sans-serif" },
  { label: 'Geist', value: "Geist, system-ui, sans-serif" },
  { label: 'Roboto', value: "Roboto, system-ui, sans-serif" },
  { label: 'IBM Plex Sans', value: "'IBM Plex Sans', system-ui, sans-serif" },
  { label: 'Source Sans 3', value: "'Source Sans 3', system-ui, sans-serif" },
];
const MONO_FONTS = [
  { label: 'System mono', value: MONO },
  { label: 'Geist Mono', value: "'Geist Mono', ui-monospace, monospace" },
  { label: 'JetBrains Mono', value: "'JetBrains Mono', ui-monospace, monospace" },
  { label: 'IBM Plex Mono', value: "'IBM Plex Mono', ui-monospace, monospace" },
  { label: 'Fira Code', value: "'Fira Code', ui-monospace, monospace" },
];

// Starting points. The built-in five seed Accent mode; the curated combos
// seed Full theme (accent + paired neutral + radius). Selecting one fills
// the controls — you then tweak from there.
const PRESETS = [
  { group: 'Built-in accents', items: [
    { label: 'Default · blue', mode: 'accent', name: 'brand',   bg: '#2563eb' },
    { label: 'Indigo',         mode: 'accent', name: 'indigo',  bg: '#4f46e5' },
    { label: 'Emerald',        mode: 'accent', name: 'emerald', bg: '#047857' },
    { label: 'Rose',           mode: 'accent', name: 'rose',    bg: '#be123c' },
    { label: 'Amber',          mode: 'accent', name: 'amber',   bg: '#f59e0b', fg: '#111827' },
  ] },
  { group: 'Curated full themes', items: [
    { label: 'Slate · Indigo',  mode: 'full', name: 'slate-indigo',  bg: '#4f46e5', neutral: 'slate',   radius: 8 },
    { label: 'Stone · Amber',   mode: 'full', name: 'stone-amber',   bg: '#f59e0b', fg: '#111827', neutral: 'stone', radius: 10 },
    { label: 'Zinc · Emerald',  mode: 'full', name: 'zinc-emerald',  bg: '#047857', neutral: 'zinc',    radius: 6 },
    { label: 'Neutral · Rose',  mode: 'full', name: 'neutral-rose',  bg: '#be123c', neutral: 'neutral', radius: 4 },
  ] },
];
// Flatten for stable indexed lookup from the <select>.
const PRESET_FLAT = PRESETS.flatMap((g) => g.items);

// Core version for the email manifest comment (reproducibility header).
import corePkg from '../../../../packages/core/package.json';
---

<div class="tb not-content" data-theme-builder data-presets={JSON.stringify(PRESET_FLAT)} data-core-version={corePkg.version}>
  <div class="tb__grid">
    <form class="tb__controls" autocomplete="off">
      <label class="hc-field">
        <span class="hc-field__label">Start from a preset</span>
        <select class="hc-select" id="tb-preset">
          <option value="">Custom</option>
          {PRESETS.map((g) => (
            <optgroup label={g.group}>
              {g.items.map((p) => <option value={String(PRESET_FLAT.indexOf(p))}>{p.label}</option>)}
            </optgroup>
          ))}
        </select>
        <span class="hc-field__message">Seeds the controls; tweak from there.</span>
      </label>

      <label class="hc-field">
        <span class="hc-field__label">Mode</span>
        <select class="hc-select" id="tb-mode">
          <option value="accent">Accent (new data-color)</option>
          <option value="full">Full theme (accent + neutrals + radius)</option>
        </select>
      </label>

      <label class="hc-field">
        <span class="hc-field__label">Theme name</span>
        <input class="hc-input" type="text" id="tb-name" value="brand"
               pattern="[a-z][a-z0-9-]*" spellcheck="false" aria-describedby="tb-name-hint" />
        <span class="hc-field__message" id="tb-name-hint">Lowercase, kebab-case. Used in file names and the <code>data-color</code> value.</span>
      </label>

      <label class="hc-field">
        <span class="hc-field__label">Brand color</span>
        <span class="tb__colorrow">
          <input type="color" id="tb-color" value="#7c3aed" aria-label="Brand color picker" />
          <input class="hc-input" type="text" id="tb-hex" value="#7c3aed" spellcheck="false" aria-label="Brand color hex" />
        </span>
        <span class="hc-field__message">The primary action / accent color.</span>
      </label>

      <label class="hc-field">
        <span class="hc-field__label">Text on primary</span>
        <select class="hc-select" id="tb-fg">
          <option value="auto">Auto (best contrast)</option>
          <option value="#ffffff">White</option>
          <option value="#111827">Dark (gray.900)</option>
        </select>
      </label>

      <label class="hc-field">
        <span class="hc-field__label">Hover darkness <output id="tb-hover-out">12%</output></span>
        <input class="hc-slider" type="range" id="tb-hover" min="0" max="30" value="12" step="1" />
      </label>

      <label class="hc-field">
        <span class="hc-field__label">Soft tint <output id="tb-soft-out">12%</output></span>
        <input class="hc-slider" type="range" id="tb-soft" min="6" max="24" value="12" step="1" />
      </label>

      <div id="tb-full-controls" hidden>
        <label class="hc-field">
          <span class="hc-field__label">Neutral ramp</span>
          <select class="hc-select" id="tb-neutral">
            <option value="gray">Gray (default)</option>
            <option value="slate">Slate (cool)</option>
            <option value="zinc">Zinc</option>
            <option value="neutral">Neutral (pure)</option>
            <option value="stone">Stone (warm)</option>
          </select>
          <span class="hc-field__message">Drives surface / text / border / secondary across light and dark.</span>
        </label>

        <label class="hc-field">
          <span class="hc-field__label">Control radius <output id="tb-radius-out">6px</output></span>
          <input class="hc-slider" type="range" id="tb-radius" min="0" max="16" value="6" step="1" />
          <span class="hc-field__message">Corner radius of buttons / inputs / tabs (<code>--hc-control-radius</code>).</span>
        </label>

        <label class="hc-field">
          <span class="hc-field__label">Body font</span>
          <select class="hc-select" id="tb-font-body">
            {BODY_FONTS.map((f) => <option value={f.value}>{f.label}</option>)}
          </select>
        </label>

        <label class="hc-field">
          <span class="hc-field__label">Heading font</span>
          <select class="hc-select" id="tb-font-heading">
            {BODY_FONTS.map((f) => <option value={f.value}>{f.label}</option>)}
          </select>
          <span class="hc-field__message">HC has no heading component — apply <code>--hc-font-family-heading</code> to your own headings.</span>
        </label>

        <label class="hc-field">
          <span class="hc-field__label">Mono font</span>
          <select class="hc-select" id="tb-font-mono">
            {MONO_FONTS.map((f) => <option value={f.value}>{f.label}</option>)}
          </select>
          <span class="hc-field__message">HC ships no webfonts — load the chosen face yourself.</span>
        </label>
      </div>

      <div class="tb__actions">
        <button type="button" class="hc-button" data-variant="primary" id="tb-apply">Apply to this page</button>
        <button type="button" class="hc-button" data-variant="ghost" id="tb-reset">Reset</button>
      </div>
      <div class="tb__actions">
        <button type="button" class="hc-button" data-variant="secondary" data-size="sm" id="tb-shuffle">🎲 Shuffle</button>
        <button type="button" class="hc-button" data-variant="secondary" data-size="sm" id="tb-share">Copy share link</button>
      </div>
    </form>

    <div class="tb__preview">
      <div class="tb__contrast" id="tb-contrast" role="status" aria-live="polite"></div>
      <div class="tb__row" data-hc-builder-preview>
        <button class="hc-button" data-variant="primary">Save</button>
        <button class="hc-button" data-variant="secondary">Cancel</button>
        <button class="hc-button" data-variant="ghost">Edit</button>
        <input class="hc-input" type="text" value="focus me" style="inline-size:7rem;" />
        <select class="hc-select" style="inline-size:7rem;"><option>Option</option></select>
        <label class="hc-checkbox-label"><input class="hc-checkbox" type="checkbox" checked /> Notify</label>
        <label class="hc-radio-label"><input class="hc-radio" type="radio" name="tb-radio" checked /> Free</label>
        <label class="hc-switch-label"><input class="hc-switch" type="checkbox" role="switch" checked /> Sync</label>
        <span class="hc-badge" data-variant="success">Active</span>
        <span class="hc-badge">Neutral</span>

        <div class="hc-alert" data-variant="success" role="status" style="flex:1 1 100%;">
          <strong class="hc-alert__title" style="font-family:var(--hc-font-family-heading);">Saved</strong>
          <p class="hc-alert__body" style="margin:0;">Semantic status colors (success / warning / error) stay fixed — the accent doesn't touch them.</p>
        </div>

        <div class="hc-card tb__card">
          <div class="hc-card__body">
            <span style="display:block;font-family:var(--hc-font-family-heading);font-weight:600;font-size:1.05rem;color:var(--hc-color-text);">Heading sample</span>
            <p class="hc-field__message" style="margin:.25rem 0 0;">Body text on this ramp — press <kbd class="hc-kbd">⌘K</kbd> (mono). Select me for ::selection.</p>
          </div>
        </div>
      </div>
      <p class="tb__hint">
        Scoped to this box and rendered by the real token build. Toggle the site's
        light/dark switch to check both. <strong>Apply to this page</strong> themes the whole site.
      </p>
    </div>
  </div>

  <div class="tb__export">
    <div class="tb__tabs" role="tablist" aria-label="Export format">
      <button type="button" class="tb__tab" role="tab" aria-selected="true" data-tab="block">Theme CSS block</button>
      <button type="button" class="tb__tab" role="tab" aria-selected="false" data-tab="dtcg">DTCG token file</button>
      <button type="button" class="tb__tab" role="tab" aria-selected="false" data-tab="full">Full token CSS</button>
      <button type="button" class="tb__tab" role="tab" aria-selected="false" data-tab="email">Email templates</button>
    </div>

    <div class="tb__panel" data-panel="block">
      <p class="tb__paneldesc" id="tb-block-desc">Additive — keep the stock CSS and load this after it. No build.</p>
      <div class="tb__panelactions">
        <button type="button" class="hc-button tb__copy" data-variant="secondary" data-size="sm" data-copy="tb-block">Copy</button>
        <button type="button" class="hc-button" data-variant="secondary" data-size="sm" data-download="tb-block" data-ext="css">Download .css</button>
      </div>
      <pre><code id="tb-block"></code></pre>
    </div>

    <div class="tb__panel" data-panel="dtcg" hidden>
      <p class="tb__paneldesc" id="tb-dtcg-desc">Save as <code>color.&lt;name&gt;.tokens.json</code> and register it in <code>build-tokens.mjs</code> (Path B).</p>
      <div class="tb__panelactions">
        <button type="button" class="hc-button tb__copy" data-variant="secondary" data-size="sm" data-copy="tb-dtcg">Copy</button>
        <button type="button" class="hc-button" data-variant="secondary" data-size="sm" data-download="tb-dtcg" data-ext="json">Download .json</button>
      </div>
      <pre><code id="tb-dtcg"></code></pre>
    </div>

    <div class="tb__panel" data-panel="full" hidden>
      <p class="tb__paneldesc">The complete token CSS (all built-in themes + yours). Drop-in replacement for the stock token stylesheet.</p>
      <div class="tb__panelactions">
        <button type="button" class="hc-button tb__copy" data-variant="secondary" data-size="sm" data-copy="tb-full">Copy</button>
        <button type="button" class="hc-button" data-variant="secondary" data-size="sm" data-download="tb-full" data-ext="css">Download .css</button>
      </div>
      <pre><code id="tb-full"></code></pre>
    </div>

    <div class="tb__panel" data-panel="email" hidden>
      <p class="tb__paneldesc">
        HTML email templates with this theme baked into inline styles — table
        layouts, 600px container, dark-mode <code>&lt;style&gt;</code> partial.
        See the <a href="/hypermedia-components/integrations/html-email/">HTML email guide</a>
        for usage. Regenerate after changing the theme (each file carries a
        manifest comment with its settings).
      </p>
      <div class="tb__panelactions">
        <label class="tb__emflavor">
          <span>Flavor</span>
          <select class="hc-select" data-size="sm" id="tb-em-flavor">
            <option value="thymeleaf">Thymeleaf (th:fragment)</option>
            <option value="plain">Plain HTML</option>
          </select>
        </label>
        <button type="button" class="hc-button" data-variant="secondary" data-size="sm" data-emdl="hc-email.html">Download hc-email.html</button>
        <button type="button" class="hc-button" data-variant="secondary" data-size="sm" data-emdl="hc-email-layout.html">Download hc-email-layout.html</button>
        <button type="button" class="hc-button" data-variant="secondary" data-size="sm" data-emdl="email-tokens.json">Download email-tokens.json</button>
      </div>
      <iframe class="tb__emframe" id="tb-em-preview" title="Themed email preview (sample content)"></iframe>
      <p class="tb__hint">
        Preview shows the plain flavor with sample copy. Dark-mode overrides
        follow your OS/browser <code>prefers-color-scheme</code>, not the
        site's theme toggle.
      </p>
    </div>
  </div>
</div>

<script>
  import { buildTokensCss, resolveTokens, DEFAULT_SOURCES } from '@hypermedia-components/core/token-transform';
  import {
    buildEmailFiles,
    emailManifestComment,
    emailTokensJson,
    EMAIL_FRAGMENTS,
    EMAIL_PARTIALS,
  } from '@hypermedia-components/core/email-transform';
  import emLayout from '@hypermedia-components/core/email/layout/fragment.html?raw';
  import emStyles from '@hypermedia-components/core/email/styles/fragment.html?raw';
  import emButton from '@hypermedia-components/core/email/button/fragment.html?raw';
  import emHeading from '@hypermedia-components/core/email/heading/fragment.html?raw';
  import emText from '@hypermedia-components/core/email/text/fragment.html?raw';
  import emLink from '@hypermedia-components/core/email/link/fragment.html?raw';
  import emSeparator from '@hypermedia-components/core/email/separator/fragment.html?raw';
  import emBadge from '@hypermedia-components/core/email/badge/fragment.html?raw';
  import emAlert from '@hypermedia-components/core/email/alert/fragment.html?raw';
  import emPanel from '@hypermedia-components/core/email/panel/fragment.html?raw';
  import emTable from '@hypermedia-components/core/email/table/fragment.html?raw';
  import emFooter from '@hypermedia-components/core/email/footer/fragment.html?raw';
  import primitive from '@hypermedia-components/core/tokens/primitive.tokens.json';
  import semantic from '@hypermedia-components/core/tokens/semantic.tokens.json';
  import component from '@hypermedia-components/core/tokens/component.tokens.json';
  import themeDark from '@hypermedia-components/core/tokens/theme.dark.tokens.json';
  import densityComfortable from '@hypermedia-components/core/tokens/density.comfortable.tokens.json';
  import densityCompact from '@hypermedia-components/core/tokens/density.compact.tokens.json';
  import densityDense from '@hypermedia-components/core/tokens/density.dense.tokens.json';
  import colorDefault from '@hypermedia-components/core/tokens/color.default.tokens.json';
  import colorIndigo from '@hypermedia-components/core/tokens/color.indigo.tokens.json';
  import colorEmerald from '@hypermedia-components/core/tokens/color.emerald.tokens.json';
  import colorRose from '@hypermedia-components/core/tokens/color.rose.tokens.json';
  import colorAmber from '@hypermedia-components/core/tokens/color.amber.tokens.json';

  const BASE_TREES = {
    primitive, semantic, component,
    'theme.dark': themeDark,
    'density.comfortable': densityComfortable,
    'density.compact': densityCompact,
    'density.dense': densityDense,
    'color.default': colorDefault,
    'color.indigo': colorIndigo,
    'color.emerald': colorEmerald,
    'color.rose': colorRose,
    'color.amber': colorAmber,
  };

  // Neutral ramps live in the primitive tokens (slate/zinc/neutral/stone +
  // the default gray). Reference them by DTCG path so the builder stays a
  // single source of truth with the library — buildTokensCss resolves the
  // {ref} against the imported primitive tree, and the DTCG export shows
  // proper {primitive.color.*} references rather than baked hex.
  const NEUTRALS = ['gray', 'slate', 'zinc', 'neutral', 'stone'];
  const nref = (ramp, shade) => `{primitive.color.${ramp}.${shade}}`;

  // ---- Color maths (WCAG 2.x) ----
  function hexToRgb(hex) { const m=/^#?([0-9a-f]{6})$/i.exec(hex.trim()); if(!m) return null; const n=parseInt(m[1],16); return [(n>>16)&255,(n>>8)&255,n&255]; }
  function rgbToHex([r,g,b]) { const h=(v)=>Math.max(0,Math.min(255,Math.round(v))).toString(16).padStart(2,'0'); return `#${h(r)}${h(g)}${h(b)}`; }
  function darken(hex,pct){ const rgb=hexToRgb(hex); if(!rgb) return hex; const k=1-pct/100; return rgbToHex(rgb.map((c)=>c*k)); }
  function luminance([r,g,b]){ const lin=(c)=>{const s=c/255; return s<=0.03928?s/12.92:Math.pow((s+0.055)/1.055,2.4);}; return 0.2126*lin(r)+0.7152*lin(g)+0.0722*lin(b); }
  function contrast(a,b){ const ra=hexToRgb(a),rb=hexToRgb(b); if(!ra||!rb) return 1; const la=luminance(ra),lb=luminance(rb); const [hi,lo]=la>lb?[la,lb]:[lb,la]; return (hi+0.05)/(lo+0.05); }
  const WHITE='#ffffff', DARK='#111827';

  const c = (v) => ({ $type: 'color', $value: v });

  // ---- CSS block parse / diff helpers ----
  function parseBlocks(css){
    const inner = css.replace(/^[\s\S]*?@layer hc\.tokens\s*\{/, '').replace(/\}\s*$/, '');
    const blocks = [];
    const re = /([^{}]+)\{([^{}]*)\}/g;
    let m;
    while ((m = re.exec(inner))) {
      const selector = m[1].trim().replace(/\s+/g, ' ');
      const vars = new Map();
      for (const decl of m[2].split(';')) {
        const i = decl.indexOf(':');
        if (i < 0) continue;
        const k = decl.slice(0, i).trim();
        if (k.startsWith('--')) vars.set(k, decl.slice(i + 1).trim());
      }
      blocks.push({ selector, vars });
    }
    return blocks;
  }
  function diffCss(stockCss, themedCss){
    const stock = new Map();
    for (const b of parseBlocks(stockCss)) stock.set(b.selector, b.vars);
    const out = [];
    for (const b of parseBlocks(themedCss)) {
      const sv = stock.get(b.selector) || new Map();
      const changed = [];
      for (const [k, v] of b.vars) if (sv.get(k) !== v) changed.push([k, v]);
      if (changed.length) out.push({ selector: b.selector, changed });
    }
    return out;
  }
  function serializeDiff(diff){
    const body = diff.map(({ selector, changed }) =>
      `  ${selector} {\n${changed.map(([k, v]) => `    ${k}: ${v};`).join('\n')}\n  }`).join('\n\n');
    return `@layer hc.tokens {\n${body}\n}\n`;
  }

  // ---- Synthetic DTCG trees from the model ----
  function accentTree(m){
    return {
      $description: `${m.name} color theme. Emitted under [data-color="${m.name}"].`,
      color: {
        'focus-ring': c(m.ring),
        action: {
          primary: { bg: c(m.bg), fg: c(m.fg), border: c(m.bg) },
          'primary-hover': { bg: c(m.hover), border: c(m.hover) },
          'primary-soft': { bg: c(m.soft) },
        },
      },
    };
  }
  function semanticLightPatch(m){
    const r = (shade) => c(nref(m.neutral, shade));
    return {
      color: {
        bg: r(50), text: r(900), 'text-muted': r(600), border: r(300), 'border-strong': r(500), 'muted-bg': r(100),
        'focus-ring': c(m.ring),
        action: {
          primary: { bg: c(m.bg), fg: c(m.fg), border: c(m.bg) },
          'primary-hover': { bg: c(m.hover), border: c(m.hover) },
          'primary-soft': { bg: c(m.soft) },
          secondary: { bg: r(100), fg: r(900), border: r(100) },
          'secondary-hover': { bg: r(200), border: r(200) },
        },
        status: { neutral: { bg: r(100), fg: r(800), border: r(200) } },
      },
      control: { radius: { $type: 'dimension', $value: `${m.radius}px` } },
      font: {
        'family-sans': { $type: 'fontFamily', $value: m.fontBody },
        'family-heading': { $type: 'fontFamily', $value: m.fontHeading },
        'family-mono': { $type: 'fontFamily', $value: m.fontMono },
      },
    };
  }
  function darkPatch(m){
    const r = (shade) => c(nref(m.neutral, shade));
    return {
      color: {
        bg: r(900), surface: r(800), text: r(100), 'text-muted': r(400), border: r(700), 'muted-bg': r(700),
        action: {
          secondary: { bg: r(700), fg: r(100), border: r(700) },
          'secondary-hover': { bg: r(600), border: r(600) },
        },
        status: { neutral: { bg: r(800), fg: r(100), border: r(700) } },
      },
    };
  }
  function accentDefaultPatch(m){
    return { color: { 'focus-ring': c(m.ring), action: {
      primary: { bg: c(m.bg), fg: c(m.fg), border: c(m.bg) },
      'primary-hover': { bg: c(m.hover), border: c(m.hover) },
      'primary-soft': { bg: c(m.soft) },
    } } };
  }
  function mergeDeep(base, patch){
    const out = Array.isArray(base) ? [...base] : { ...base };
    for (const k in patch) {
      const pv = patch[k];
      out[k] = (pv && typeof pv === 'object' && !Array.isArray(pv) && base && typeof base[k] === 'object')
        ? mergeDeep(base[k], pv) : pv;
    }
    return out;
  }

  const EMAIL_SOURCES = {
    layout: emLayout, styles: emStyles,
    button: emButton, heading: emHeading, text: emText, link: emLink,
    separator: emSeparator, badge: emBadge, alert: emAlert, panel: emPanel,
    table: emTable, footer: emFooter,
  };
  // Fail fast in dev if the source inventory and the transform drift apart.
  for (const n of [...EMAIL_FRAGMENTS, ...EMAIL_PARTIALS]) {
    if (!EMAIL_SOURCES[n]) console.warn(`ThemeBuilder: missing email fragment source "${n}"`);
  }
  // The plain-flavor layout slot (th:replace stripped) — replaced with the
  // fragment kitchen sink to build the preview document.
  const EMAIL_SLOT = '<div>Email body — replaced by the content fragment.</div>';

  const root = document.querySelector('[data-theme-builder]');
  if (root) {
    const el = (id) => /** @type {any} */ (root.querySelector('#' + id));
    const $mode=el('tb-mode'), $name=el('tb-name'), $color=el('tb-color'), $hex=el('tb-hex'), $fg=el('tb-fg');
    const $hover=el('tb-hover'), $hoverOut=el('tb-hover-out'), $soft=el('tb-soft'), $softOut=el('tb-soft-out');
    const $neutral=el('tb-neutral'), $radius=el('tb-radius'), $radiusOut=el('tb-radius-out');
    const $fontBody=el('tb-font-body'), $fontHeading=el('tb-font-heading'), $fontMono=el('tb-font-mono');
    const $preset=el('tb-preset'), $shuffle=el('tb-shuffle'), $share=el('tb-share');
    const $fullControls=el('tb-full-controls'), $contrast=el('tb-contrast');
    let PRESETS_DATA = [];
    try { PRESETS_DATA = JSON.parse(root.getAttribute('data-presets') || '[]'); } catch { /* ignore */ }

    // ---- State (de)serialization: presets, share links, shuffle ----
    function applyState(s){
      if (s.mode) $mode.value = s.mode;
      if (s.name) $name.value = s.name;
      if (s.hex && /^#[0-9a-f]{6}$/i.test(s.hex)) { $hex.value = s.hex.toLowerCase(); $color.value = s.hex.toLowerCase(); }
      if (s.fg) $fg.value = s.fg;
      if (s.hover != null) { $hover.value = s.hover; $hoverOut.textContent = s.hover + '%'; }
      if (s.soft != null) { $soft.value = s.soft; $softOut.textContent = s.soft + '%'; }
      if (s.neutral) $neutral.value = s.neutral;
      if (s.radius != null) { $radius.value = s.radius; $radiusOut.textContent = s.radius + 'px'; }
      if (Number.isInteger(s.fb)) $fontBody.selectedIndex = s.fb;
      if (Number.isInteger(s.fh)) $fontHeading.selectedIndex = s.fh;
      if (Number.isInteger(s.fm)) $fontMono.selectedIndex = s.fm;
    }
    function applyPreset(p){
      if (!p) return;
      applyState({ mode: p.mode, name: p.name, hex: p.bg, fg: p.fg || 'auto',
        hover: 12, soft: 12, neutral: p.neutral || 'gray', radius: p.radius ?? 6, fb: 0, fh: 0, fm: 0 });
    }
    function currentState(){
      return { mode: $mode.value, name: $name.value, hex: $hex.value, fg: $fg.value,
        hover: Number($hover.value), soft: Number($soft.value), neutral: $neutral.value, radius: Number($radius.value),
        fb: $fontBody.selectedIndex, fh: $fontHeading.selectedIndex, fm: $fontMono.selectedIndex };
    }
    function hslToHex(h, s, l){
      s /= 100; l /= 100;
      const k = (n) => (n + h / 30) % 12;
      const a = s * Math.min(l, 1 - l);
      const f = (n) => l - a * Math.max(-1, Math.min(k(n) - 3, Math.min(9 - k(n), 1)));
      const to = (x) => Math.round(255 * x).toString(16).padStart(2, '0');
      return `#${to(f(0))}${to(f(8))}${to(f(4))}`;
    }
    function shuffle(){
      const rnd = (n) => Math.floor(Math.random() * n);
      applyState({
        mode: 'full', name: 'shuffled',
        hex: hslToHex(rnd(360), 52 + rnd(22), 42 + rnd(10)),
        fg: 'auto', hover: 8 + rnd(12), soft: 8 + rnd(12),
        neutral: NEUTRALS[rnd(NEUTRALS.length)], radius: rnd(13),
        fb: rnd($fontBody.options.length), fh: rnd($fontHeading.options.length), fm: rnd($fontMono.options.length),
      });
      $preset.value = '';
    }
    const $block=el('tb-block'), $dtcg=el('tb-dtcg'), $full=el('tb-full');
    const $blockDesc=el('tb-block-desc'), $dtcgDesc=el('tb-dtcg-desc');

    function model(){
      const bg = /^#[0-9a-f]{6}$/i.test($hex.value) ? $hex.value.toLowerCase() : '#7c3aed';
      const fg = $fg.value === 'auto' ? (contrast(bg, WHITE) >= contrast(bg, DARK) ? WHITE : DARK) : $fg.value;
      return {
        mode: $mode.value,
        name: ($name.value || 'brand').trim() || 'brand',
        bg, fg, ring: bg,
        hover: darken(bg, Number($hover.value)),
        soft: `color-mix(in srgb, ${bg} ${Number($soft.value)}%, transparent)`,
        neutral: NEUTRALS.includes($neutral.value) ? $neutral.value : 'gray',
        radius: Number($radius.value),
        fontBody: $fontBody.value,
        fontHeading: $fontHeading.value,
        fontMono: $fontMono.value,
      };
    }

    // Accent mode: a single additive [data-color] block.
    function accentBlock(m){
      return buildTokensCss({
        sources: [
          { namespace: 'primitive', emit: false },
          { namespace: 'semantic', selector: ':root', emit: false },
          { namespace: 'component', selector: ':root', emit: false },
          { namespace: 'color.custom', selector: `[data-color="${m.name}"]`, emit: true },
        ],
        trees: { primitive, semantic, component, 'color.custom': accentTree(m) },
      }).css;
    }
    function accentFull(m){
      return buildTokensCss({
        sources: [...DEFAULT_SOURCES, { namespace: 'color.custom', file: '', selector: `[data-color="${m.name}"]`, emit: true }],
        trees: { ...BASE_TREES, 'color.custom': accentTree(m) },
      }).css;
    }

    // Full theme: merge patches into the default trees, build, diff vs stock.
    function fullThemedTrees(m){
      return {
        ...BASE_TREES,
        semantic: mergeDeep(semantic, semanticLightPatch(m)),
        'color.default': mergeDeep(colorDefault, accentDefaultPatch(m)),
        'theme.dark': mergeDeep(themeDark, darkPatch(m)),
      };
    }
    const stockFullCss = () => buildTokensCss({ sources: DEFAULT_SOURCES, trees: BASE_TREES }).css;
    function fullThemedCss(m){ return buildTokensCss({ sources: DEFAULT_SOURCES, trees: fullThemedTrees(m) }).css; }
    function fullDiff(m){ return diffCss(stockFullCss(), fullThemedCss(m)); }

    // ---- Email templates (see the HTML email integration guide) ----
    // Full mode bakes the neutral ramp into the semantic/dark patches, so
    // the layer stack stays the base one; accent mode overlays the custom
    // accent tree the same way a built-in color axis would.
    function emailMaps(m){
      const full = m.mode === 'full';
      const trees = full ? fullThemedTrees(m) : { ...BASE_TREES, 'color.custom': accentTree(m) };
      const light = ['primitive', 'semantic', 'component', 'density.comfortable', 'color.default'];
      if (!full) light.push('color.custom');
      const dark = [...light, 'theme.dark'];
      const toSources = (list) => list.map((namespace) => ({ namespace }));
      return {
        tokens: resolveTokens({ sources: toSources(light), trees }),
        darkTokens: resolveTokens({ sources: toSources(dark), trees }),
      };
    }
    const $emFlavor = el('tb-em-flavor'), $emPreview = el('tb-em-preview');
    let emFiles = {};
    function renderEmail(){
      const m = model();
      const { tokens, darkTokens } = emailMaps(m);
      const flavor = $emFlavor.value === 'plain' ? 'plain' : 'thymeleaf';
      const manifest = emailManifestComment({
        version: root.getAttribute('data-core-version') || 'unknown',
        color: m.mode === 'full' ? m.name : m.name + ' (accent)',
        neutral: m.mode === 'full' ? m.neutral : 'gray',
        flavor,
        custom: true,
        command:
          'npx @hypermedia-components/cli email eject --tokens <your-dtcg-export>.json --flavor ' + flavor,
      });
      emFiles = {
        ...buildEmailFiles({ fragmentSources: EMAIL_SOURCES, tokens, darkTokens, flavor, manifest }),
        'email-tokens.json': emailTokensJson(tokens, darkTokens),
      };
      // Preview always renders the plain flavor with the sample copy, all
      // fragments injected into the layout's content slot.
      const preview = buildEmailFiles({ fragmentSources: EMAIL_SOURCES, tokens, darkTokens, flavor: 'plain' });
      $emPreview.srcdoc = preview['hc-email-layout.html'].replace(
        EMAIL_SLOT,
        preview['hc-email.html']
      );
    }

    let previewStyle = document.getElementById('hc-builder-preview-style')
      || document.head.appendChild(Object.assign(document.createElement('style'), { id: 'hc-builder-preview-style' }));
    let appliedStyle = null;

    function render(){
      const m = model();
      const full = m.mode === 'full';
      $fullControls.hidden = !full;

      // Contrast.
      const ratio = contrast(m.bg, m.fg);
      const grade = ratio >= 7 ? 'AAA' : ratio >= 4.5 ? 'AA' : ratio >= 3 ? 'AA Large' : 'Fail';
      const ok = ratio >= 4.5;
      $contrast.className = 'tb__contrast' + (ok ? ' is-pass' : ' is-fail');
      $contrast.textContent = `Text on primary: ${ratio.toFixed(2)} : 1 — ${grade}`
        + (ok ? '' : ' (below 4.5:1 — pick a darker bg or flip the text color)');

      if (!full) {
        const block = accentBlock(m);
        previewStyle.textContent = block.replaceAll(`[data-color="${m.name}"]`, '[data-hc-builder-preview]');
        $block.textContent = block.trimEnd();
        $blockDesc.innerHTML = 'Additive — keep the stock CSS, load this after it, then set <code>data-color="' + m.name + '"</code>. No build.';
        $dtcg.textContent = JSON.stringify(accentTree(m), null, 2);
        $dtcgDesc.innerHTML = 'Save as <code>color.' + m.name + '.tokens.json</code> and register it in <code>build-tokens.mjs</code> (Path B).';
      } else {
        const diff = fullDiff(m);
        // Preview: light overrides on the box, dark overrides under a dark ancestor.
        previewStyle.textContent = diff.map(({ selector, changed }) => {
          const decls = changed.map(([k, v]) => `  ${k}: ${v};`).join('\n');
          const dark = /\[data-theme="dark"\]/.test(selector);
          const sel = dark
            ? '[data-theme="dark"] [data-hc-builder-preview], [data-hc-builder-preview][data-theme="dark"]'
            : '[data-hc-builder-preview]';
          return `${sel} {\n${decls}\n}`;
        }).join('\n');
        $block.textContent = serializeDiff(diff).trimEnd();
        $blockDesc.innerHTML = 'Additive override of the default look (light + dark). Load after the stock CSS. No build.';
        $dtcg.textContent = JSON.stringify(
          { semantic: semanticLightPatch(m), 'theme.dark': darkPatch(m) }, null, 2);
        $dtcgDesc.innerHTML = 'Patch for <code>semantic.tokens.json</code> + <code>theme.dark.tokens.json</code> (merge the changed leaves, then rebuild).';
      }

      const activeFull = root.querySelector('.tb__tab[data-tab="full"][aria-selected="true"]');
      if (activeFull) $full.textContent = (full ? fullThemedCss(m) : accentFull(m)).trimEnd();
      const activeEmail = root.querySelector('.tb__tab[data-tab="email"][aria-selected="true"]');
      if (activeEmail) renderEmail();
    }

    for (const ev of ['input', 'change']) {
      $color.addEventListener(ev, () => { $hex.value = $color.value.toLowerCase(); render(); });
      $hex.addEventListener(ev, () => { if (/^#[0-9a-f]{6}$/i.test($hex.value)) $color.value = $hex.value; render(); });
      $fg.addEventListener(ev, render);
      $name.addEventListener(ev, render);
      $mode.addEventListener(ev, render);
      $neutral.addEventListener(ev, render);
      $fontBody.addEventListener(ev, render);
      $fontHeading.addEventListener(ev, render);
      $fontMono.addEventListener(ev, render);
    }
    $hover.addEventListener('input', () => { $hoverOut.textContent = $hover.value + '%'; render(); });
    $soft.addEventListener('input', () => { $softOut.textContent = $soft.value + '%'; render(); });
    $radius.addEventListener('input', () => { $radiusOut.textContent = $radius.value + 'px'; render(); });

    // Changing any control by hand drops the preset back to "Custom".
    for (const c of [$mode, $name, $color, $hex, $fg, $hover, $soft, $neutral, $radius, $fontBody, $fontHeading, $fontMono]) {
      c.addEventListener('input', () => { $preset.value = ''; });
    }
    $preset.addEventListener('change', () => {
      if ($preset.value !== '') { applyPreset(PRESETS_DATA[Number($preset.value)]); render(); }
    });
    $shuffle.addEventListener('click', () => { shuffle(); render(); });
    $share.addEventListener('click', async () => {
      try {
        const code = btoa(JSON.stringify(currentState()));
        history.replaceState(null, '', '#tb=' + code);
        await navigator.clipboard.writeText(location.href);
        const prev = $share.textContent; $share.textContent = 'Link copied!';
        setTimeout(() => { $share.textContent = prev; }, 1200);
      } catch { /* clipboard blocked — hash is still in the URL */ }
    });

    el('tb-apply').addEventListener('click', () => {
      const m = model();
      if (!appliedStyle) appliedStyle = document.head.appendChild(Object.assign(document.createElement('style'), { id: 'hc-builder-applied-style' }));
      if (m.mode === 'full') {
        appliedStyle.textContent = serializeDiff(fullDiff(m));
        document.documentElement.removeAttribute('data-color');
      } else {
        appliedStyle.textContent = accentBlock(m);
        document.documentElement.setAttribute('data-color', m.name);
      }
    });
    el('tb-reset').addEventListener('click', () => {
      if (appliedStyle) appliedStyle.textContent = '';
      document.documentElement.removeAttribute('data-color');
    });

    for (const tab of root.querySelectorAll('.tb__tab')) {
      tab.addEventListener('click', () => {
        const which = tab.getAttribute('data-tab');
        for (const t of root.querySelectorAll('.tb__tab')) t.setAttribute('aria-selected', String(t === tab));
        for (const p of root.querySelectorAll('.tb__panel')) p.hidden = p.getAttribute('data-panel') !== which;
        if (which === 'full') { const m = model(); $full.textContent = (m.mode === 'full' ? fullThemedCss(m) : accentFull(m)).trimEnd(); }
        if (which === 'email') renderEmail();
      });
    }
    $emFlavor.addEventListener('change', renderEmail);

    for (const btn of root.querySelectorAll('[data-emdl]')) {
      btn.addEventListener('click', () => {
        const name = btn.getAttribute('data-emdl');
        if (!emFiles[name]) renderEmail();
        const blob = new Blob([emFiles[name] || ''], {
          type: name.endsWith('.json') ? 'application/json' : 'text/html',
        });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url; a.download = name; a.click();
        URL.revokeObjectURL(url);
      });
    }

    for (const btn of root.querySelectorAll('[data-copy]')) {
      btn.addEventListener('click', async () => {
        const target = root.querySelector('#' + btn.getAttribute('data-copy'));
        if (!target) return;
        try {
          await navigator.clipboard.writeText(target.textContent || '');
          const prev = btn.textContent; btn.textContent = 'Copied!';
          setTimeout(() => { btn.textContent = prev; }, 1200);
        } catch { /* clipboard blocked */ }
      });
    }

    for (const btn of root.querySelectorAll('[data-download]')) {
      btn.addEventListener('click', () => {
        const target = root.querySelector('#' + btn.getAttribute('data-download'));
        if (!target) return;
        const m = model();
        const ext = btn.getAttribute('data-ext');
        const id = btn.getAttribute('data-download');
        const name = id === 'tb-dtcg'
          ? (m.mode === 'full' ? `theme.${m.name}.patch.json` : `color.${m.name}.tokens.json`)
          : id === 'tb-full' ? 'hc.tokens.css'
          : `hc.theme.${m.name}.css`;
        const blob = new Blob([target.textContent || ''], { type: ext === 'json' ? 'application/json' : 'text/css' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url; a.download = name; a.click();
        URL.revokeObjectURL(url);
      });
    }

    // Restore from a share link (#tb=<base64>) on load.
    const shared = location.hash.match(/tb=([^&]+)/);
    if (shared) { try { applyState(JSON.parse(atob(shared[1]))); } catch { /* ignore bad link */ } }

    render();
  }
</script>

<style>
  .tb { margin-block: 1.5rem; }
  .tb__grid { display: grid; gap: 1.5rem; grid-template-columns: 1fr; }
  @media (min-width: 56rem) { .tb__grid { grid-template-columns: minmax(16rem, 22rem) 1fr; align-items: start; } }
  .tb__controls { display: grid; gap: 1rem; }
  #tb-full-controls { display: grid; gap: 1rem; }
  /* An id selector beats the UA `[hidden] { display: none }`, so re-assert
     it — otherwise the Full-theme-only controls stay visible in Accent mode. */
  #tb-full-controls[hidden] { display: none; }
  .tb__colorrow { display: flex; gap: 0.5rem; align-items: center; }
  .tb__colorrow input[type='color'] {
    inline-size: 2.75rem; block-size: 2.5rem; padding: 0; flex: none; cursor: pointer;
    border: 1px solid var(--hc-color-border, #d1d5db); border-radius: var(--hc-radius-md, 0.375rem); background: none;
  }
  .tb__actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .tb__preview {
    display: grid; gap: 0.75rem; padding: 1.25rem;
    border: 1px solid var(--hc-color-border, #e5e7eb); border-radius: var(--hc-radius-lg, 0.5rem);
    background: var(--hc-color-bg, #fff);
  }
  .tb__row { display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center; }
  .tb__card { flex: 1 1 100%; }
  .tb__hint { margin: 0; font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); }
  .tb__contrast { font-size: var(--sl-text-sm); font-weight: 600; padding: 0.4rem 0.7rem; border-radius: var(--hc-radius-md, 0.375rem); }
  .tb__contrast.is-pass { color: #065f46; background: color-mix(in srgb, #10b981 14%, transparent); }
  .tb__contrast.is-fail { color: #991b1b; background: color-mix(in srgb, #ef4444 14%, transparent); }
  :global([data-theme='dark']) .tb__contrast.is-pass { color: #6ee7b7; }
  :global([data-theme='dark']) .tb__contrast.is-fail { color: #fca5a5; }
  .tb__export { margin-block-start: 1.5rem; }
  .tb__tabs { display: flex; gap: 0.25rem; flex-wrap: wrap; border-block-end: 1px solid var(--hc-color-border, #e5e7eb); }
  .tb__tab {
    appearance: none; border: none; background: none; padding: 0.5rem 0.9rem; font: inherit;
    font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); cursor: pointer;
    border-block-end: 2px solid transparent; margin-block-end: -1px;
  }
  .tb__tab[aria-selected='true'] { color: var(--sl-color-text-accent); border-block-end-color: currentColor; }
  .tb__paneldesc { margin-block: 0.75rem 0.5rem; font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); }
  .tb__panelactions { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-block-end: 0.5rem; }
  .tb__panel pre { overflow: auto; max-block-size: 28rem; }
  .tb__emflavor { display: inline-flex; gap: 0.5rem; align-items: center; font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); }
  .tb__emframe {
    inline-size: 100%; block-size: 30rem; border: 1px solid var(--hc-color-border, #e5e7eb);
    border-radius: var(--hc-radius-md, 0.375rem); background: #fff;
  }
</style>
