---
// Interactive theme builder for the docs.
//
// Takes one brand colour and derives the full accent token set the
// `data-color` axis needs (focus ring, primary bg/fg/border, hover,
// soft tint), checks WCAG contrast for the text-on-primary pair live,
// and emits both export formats documented in tokens/themes.mdx:
//   - Path A: a `[data-color="…"]` CSS override block
//   - Path B: a `color.*.tokens.json` DTCG source
//
// All logic is client-side vanilla JS in the <script> below (bundled
// by Astro). The controls dogfood HC's own .hc-input / .hc-select /
// .hc-button; the preview reuses the same row as the themes.mdx live
// preview so the two stay visually consistent.
---

<div class="tb not-content" data-theme-builder>
  <div class="tb__grid">
    {/* ---- Controls ---- */}
    <form class="tb__controls" autocomplete="off">
      <label class="hc-field">
        <span class="hc-field__label">Theme name</span>
        <input class="hc-input" type="text" id="tb-name" value="brand"
               pattern="[a-z][a-z0-9-]*" spellcheck="false"
               aria-describedby="tb-name-hint" />
        <span class="hc-field__message" id="tb-name-hint">
          Used as <code>data-color="…"</code> and the file name. Lowercase, kebab-case.
        </span>
      </label>

      <label class="hc-field">
        <span class="hc-field__label">Brand colour</span>
        <span class="tb__colorrow">
          <input type="color" id="tb-color" value="#7c3aed" aria-label="Brand colour picker" />
          <input class="hc-input" type="text" id="tb-hex" value="#7c3aed"
                 spellcheck="false" aria-label="Brand colour hex" />
        </span>
        <span class="hc-field__message">
          The primary action / accent colour. Everything else is derived from it.
        </span>
      </label>

      <label class="hc-field">
        <span class="hc-field__label">Text on primary</span>
        <select class="hc-select" id="tb-fg">
          <option value="auto">Auto (best contrast)</option>
          <option value="#ffffff">White</option>
          <option value="#111827">Dark (gray.900)</option>
        </select>
      </label>

      <label class="hc-field">
        <span class="hc-field__label">
          Hover darkness <output id="tb-hover-out">12%</output>
        </span>
        <input class="hc-slider" type="range" id="tb-hover" min="0" max="30" value="12" step="1" />
        <span class="hc-field__message">How much darker the hover / active state is.</span>
      </label>

      <label class="hc-field">
        <span class="hc-field__label">
          Soft tint <output id="tb-soft-out">12%</output>
        </span>
        <input class="hc-slider" type="range" id="tb-soft" min="6" max="24" value="12" step="1" />
        <span class="hc-field__message">
          Ghost-hover / <code>::selection</code> tint, blended with <code>transparent</code>.
        </span>
      </label>

      <div class="tb__actions">
        <button type="button" class="hc-button" data-variant="primary" id="tb-apply">
          Apply to this page
        </button>
        <button type="button" class="hc-button" data-variant="ghost" id="tb-reset">
          Reset
        </button>
      </div>
    </form>

    {/* ---- Live preview ---- */}
    <div class="tb__preview">
      <div class="tb__contrast" id="tb-contrast" role="status" aria-live="polite"></div>

      <div class="tb__row" id="tb-sample">
        <button class="hc-button" data-variant="primary">Save</button>
        <button class="hc-button" data-variant="ghost">Edit</button>
        <input class="hc-input" type="text" value="focus me" style="inline-size:9rem;" />
        <label class="hc-checkbox-label">
          <input class="hc-checkbox" type="checkbox" checked />
          Notify me
        </label>
        <label class="hc-radio-label">
          <input class="hc-radio" type="radio" name="tb-radio" checked />
          Free
        </label>
        <span class="hc-field__message">Select this text to preview ::selection.</span>
      </div>
      <p class="tb__hint">
        The preview is scoped to this box. Use <strong>Apply to this page</strong>
        to flip the whole docs site to your theme, or copy an export below.
      </p>
    </div>
  </div>

  {/* ---- Export ---- */}
  <div class="tb__export">
    <div class="tb__tabs" role="tablist" aria-label="Export format">
      <button type="button" class="tb__tab" role="tab" aria-selected="true" data-tab="css">CSS override</button>
      <button type="button" class="tb__tab" role="tab" aria-selected="false" data-tab="json">DTCG token file</button>
    </div>

    <div class="tb__panel" data-panel="css">
      <button type="button" class="hc-button tb__copy" data-variant="secondary" data-size="sm" data-copy="tb-css">Copy</button>
      <pre><code id="tb-css"></code></pre>
    </div>
    <div class="tb__panel" data-panel="json" hidden>
      <button type="button" class="hc-button tb__copy" data-variant="secondary" data-size="sm" data-copy="tb-json">Copy</button>
      <pre><code id="tb-json"></code></pre>
    </div>
  </div>
</div>

<script>
  // ---- Colour maths (WCAG 2.x) ----

  /** @param {string} hex @returns {[number,number,number] | null} */
  function hexToRgb(hex) {
    const m = /^#?([0-9a-f]{6})$/i.exec(hex.trim());
    if (!m) return null;
    const n = parseInt(m[1], 16);
    return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
  }

  /** @param {[number,number,number]} rgb @returns {string} */
  function rgbToHex([r, g, b]) {
    const h = (v) => Math.max(0, Math.min(255, Math.round(v))).toString(16).padStart(2, '0');
    return `#${h(r)}${h(g)}${h(b)}`;
  }

  /** Darken toward black by `pct` percent, per channel (sRGB). */
  function darken(hex, pct) {
    const rgb = hexToRgb(hex);
    if (!rgb) return hex;
    const k = 1 - pct / 100;
    return rgbToHex(/** @type {[number,number,number]} */ (rgb.map((c) => c * k)));
  }

  /** Relative luminance per WCAG. */
  function luminance([r, g, b]) {
    const lin = (c) => {
      const s = c / 255;
      return s <= 0.03928 ? s / 12.92 : Math.pow((s + 0.055) / 1.055, 2.4);
    };
    return 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b);
  }

  /** Contrast ratio between two hex colours (1–21). */
  function contrast(hexA, hexB) {
    const a = hexToRgb(hexA);
    const b = hexToRgb(hexB);
    if (!a || !b) return 1;
    const la = luminance(a);
    const lb = luminance(b);
    const [hi, lo] = la > lb ? [la, lb] : [lb, la];
    return (hi + 0.05) / (lo + 0.05);
  }

  const WHITE = '#ffffff';
  const DARK = '#111827'; // gray.900 — matches the amber theme's choice

  // ---- Wiring ----

  const root = document.querySelector('[data-theme-builder]');
  if (root) {
    /** @param {string} id @returns {any} */
    const el = (id) => root.querySelector('#' + id);

    const $name = el('tb-name');
    const $color = el('tb-color');
    const $hex = el('tb-hex');
    const $fg = el('tb-fg');
    const $hover = el('tb-hover');
    const $hoverOut = el('tb-hover-out');
    const $soft = el('tb-soft');
    const $softOut = el('tb-soft-out');
    const $sample = el('tb-sample');
    const $contrast = el('tb-contrast');
    const $css = el('tb-css');
    const $json = el('tb-json');

    /** @returns {{name:string,bg:string,fg:string,hover:string,soft:string,ring:string,softPct:number}} */
    function model() {
      const bg = /^#[0-9a-f]{6}$/i.test($hex.value) ? $hex.value.toLowerCase() : '#7c3aed';
      const fgChoice = $fg.value;
      const fg =
        fgChoice === 'auto'
          ? contrast(bg, WHITE) >= contrast(bg, DARK)
            ? WHITE
            : DARK
          : fgChoice;
      const hover = darken(bg, Number($hover.value));
      const softPct = Number($soft.value);
      const soft = `color-mix(in srgb, ${bg} ${softPct}%, transparent)`;
      const name = ($name.value || 'brand').trim() || 'brand';
      return { name, bg, fg, hover, soft, ring: bg, softPct };
    }

    function render() {
      const m = model();

      // Live preview — set the accent tokens on the scoped box only.
      const s = $sample.style;
      s.setProperty('--hc-color-action-primary-bg', m.bg);
      s.setProperty('--hc-color-action-primary-fg', m.fg);
      s.setProperty('--hc-color-action-primary-border', m.bg);
      s.setProperty('--hc-color-action-primary-hover-bg', m.hover);
      s.setProperty('--hc-color-action-primary-hover-border', m.hover);
      s.setProperty('--hc-color-action-primary-soft-bg', m.soft);
      s.setProperty('--hc-color-focus-ring', m.ring);

      // Contrast read-out.
      const ratio = contrast(m.bg, m.fg);
      const grade = ratio >= 7 ? 'AAA' : ratio >= 4.5 ? 'AA' : ratio >= 3 ? 'AA Large' : 'Fail';
      const ok = ratio >= 4.5;
      $contrast.className = 'tb__contrast' + (ok ? ' is-pass' : ' is-fail');
      $contrast.textContent =
        `Text on primary: ${ratio.toFixed(2)} : 1 — ${grade}` +
        (ok ? '' : ' (below 4.5:1 — pick a darker bg or flip the text colour)');

      // Exports.
      $css.textContent =
        `[data-color="${m.name}"] {\n` +
        `  --hc-color-focus-ring: ${m.ring};\n` +
        `  --hc-color-action-primary-bg: ${m.bg};\n` +
        `  --hc-color-action-primary-fg: ${m.fg};\n` +
        `  --hc-color-action-primary-border: ${m.bg};\n` +
        `  --hc-color-action-primary-hover-bg: ${m.hover};\n` +
        `  --hc-color-action-primary-hover-border: ${m.hover};\n` +
        `  --hc-color-action-primary-soft-bg: ${m.soft};\n` +
        `}`;

      $json.textContent = JSON.stringify(
        {
          $description: `${m.name} colour theme. Emitted under [data-color="${m.name}"].`,
          color: {
            'focus-ring': { $type: 'color', $value: m.ring },
            action: {
              primary: {
                bg: { $type: 'color', $value: m.bg },
                fg: { $type: 'color', $value: m.fg },
                border: { $type: 'color', $value: m.bg },
              },
              'primary-hover': {
                bg: { $type: 'color', $value: m.hover },
                border: { $type: 'color', $value: m.hover },
              },
              'primary-soft': {
                bg: { $type: 'color', $value: m.soft },
              },
            },
          },
        },
        null,
        2,
      );
    }

    // Keep the colour picker and hex text in sync.
    $color.addEventListener('input', () => {
      $hex.value = $color.value.toLowerCase();
      render();
    });
    $hex.addEventListener('input', () => {
      if (/^#[0-9a-f]{6}$/i.test($hex.value)) $color.value = $hex.value;
      render();
    });
    $hover.addEventListener('input', () => {
      $hoverOut.textContent = $hover.value + '%';
      render();
    });
    $soft.addEventListener('input', () => {
      $softOut.textContent = $soft.value + '%';
      render();
    });
    $fg.addEventListener('change', render);
    $name.addEventListener('input', render);

    // Apply to the whole page (writes the vars onto <html> under a
    // dedicated data-color value so it wins over the navbar picker).
    el('tb-apply').addEventListener('click', () => {
      const m = model();
      const r = document.documentElement;
      r.style.setProperty('--hc-color-action-primary-bg', m.bg);
      r.style.setProperty('--hc-color-action-primary-fg', m.fg);
      r.style.setProperty('--hc-color-action-primary-border', m.bg);
      r.style.setProperty('--hc-color-action-primary-hover-bg', m.hover);
      r.style.setProperty('--hc-color-action-primary-hover-border', m.hover);
      r.style.setProperty('--hc-color-action-primary-soft-bg', m.soft);
      r.style.setProperty('--hc-color-focus-ring', m.ring);
      r.setAttribute('data-color', m.name);
    });

    el('tb-reset').addEventListener('click', () => {
      const r = document.documentElement;
      for (const v of [
        '--hc-color-action-primary-bg',
        '--hc-color-action-primary-fg',
        '--hc-color-action-primary-border',
        '--hc-color-action-primary-hover-bg',
        '--hc-color-action-primary-hover-border',
        '--hc-color-action-primary-soft-bg',
        '--hc-color-focus-ring',
      ]) {
        r.style.removeProperty(v);
      }
      r.removeAttribute('data-color');
    });

    // Export tabs.
    for (const tab of root.querySelectorAll('.tb__tab')) {
      tab.addEventListener('click', () => {
        const which = tab.getAttribute('data-tab');
        for (const t of root.querySelectorAll('.tb__tab')) {
          t.setAttribute('aria-selected', String(t === tab));
        }
        for (const p of root.querySelectorAll('.tb__panel')) {
          p.hidden = p.getAttribute('data-panel') !== which;
        }
      });
    }

    // Copy buttons.
    for (const btn of root.querySelectorAll('[data-copy]')) {
      btn.addEventListener('click', async () => {
        const target = root.querySelector('#' + btn.getAttribute('data-copy'));
        if (!target) return;
        try {
          await navigator.clipboard.writeText(target.textContent || '');
          const prev = btn.textContent;
          btn.textContent = 'Copied!';
          setTimeout(() => { btn.textContent = prev; }, 1200);
        } catch {
          /* clipboard blocked — the text is still selectable */
        }
      });
    }

    render();
  }
</script>

<style>
  .tb {
    margin-block: 1.5rem;
  }
  .tb__grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 56rem) {
    .tb__grid {
      grid-template-columns: minmax(16rem, 22rem) 1fr;
      align-items: start;
    }
  }

  .tb__controls {
    display: grid;
    gap: 1rem;
  }
  .tb__colorrow {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  .tb__colorrow input[type='color'] {
    inline-size: 2.75rem;
    block-size: 2.5rem;
    padding: 0;
    border: 1px solid var(--hc-color-border, #d1d5db);
    border-radius: var(--hc-radius-md, 0.375rem);
    background: none;
    cursor: pointer;
    flex: none;
  }
  .tb__actions {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tb__preview {
    display: grid;
    gap: 0.75rem;
    padding: 1.25rem;
    border: 1px solid var(--hc-color-border, #e5e7eb);
    border-radius: var(--hc-radius-lg, 0.5rem);
    background: var(--hc-color-surface, #fff);
  }
  .tb__row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .tb__hint {
    margin: 0;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  .tb__contrast {
    font-size: var(--sl-text-sm);
    font-weight: 600;
    padding: 0.4rem 0.7rem;
    border-radius: var(--hc-radius-md, 0.375rem);
  }
  .tb__contrast.is-pass {
    color: #065f46;
    background: color-mix(in srgb, #10b981 14%, transparent);
  }
  .tb__contrast.is-fail {
    color: #991b1b;
    background: color-mix(in srgb, #ef4444 14%, transparent);
  }
  :global([data-theme='dark']) .tb__contrast.is-pass {
    color: #6ee7b7;
  }
  :global([data-theme='dark']) .tb__contrast.is-fail {
    color: #fca5a5;
  }

  .tb__export {
    margin-block-start: 1.5rem;
  }
  .tb__tabs {
    display: flex;
    gap: 0.25rem;
    border-block-end: 1px solid var(--hc-color-border, #e5e7eb);
  }
  .tb__tab {
    appearance: none;
    border: none;
    background: none;
    padding: 0.5rem 0.9rem;
    font: inherit;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    cursor: pointer;
    border-block-end: 2px solid transparent;
    margin-block-end: -1px;
  }
  .tb__tab[aria-selected='true'] {
    color: var(--sl-color-text-accent);
    border-block-end-color: currentColor;
  }
  .tb__panel {
    position: relative;
  }
  .tb__panel [data-copy] {
    position: absolute;
    inset-block-start: 0.6rem;
    inset-inline-end: 0.6rem;
    z-index: 1;
  }
  .tb__panel pre {
    margin-block-start: 0.75rem;
    overflow-x: auto;
  }
</style>
