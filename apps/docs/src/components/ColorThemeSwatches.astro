---
// Palette summary for the built-in color themes, resolved from the real
// color.*.tokens.json sources + primitives. Each theme is accent-only, so
// its "palette" is the primary / hover / soft / focus-ring / text-on-primary
// set — shown here as swatches.
import primitive from '@hypermedia-components/core/tokens/primitive.tokens.json';
import def from '@hypermedia-components/core/tokens/color.default.tokens.json';
import indigo from '@hypermedia-components/core/tokens/color.indigo.tokens.json';
import emerald from '@hypermedia-components/core/tokens/color.emerald.tokens.json';
import rose from '@hypermedia-components/core/tokens/color.rose.tokens.json';
import amber from '@hypermedia-components/core/tokens/color.amber.tokens.json';

const THEMES = [
  { name: 'default', tree: def },
  { name: 'indigo', tree: indigo },
  { name: 'emerald', tree: emerald },
  { name: 'rose', tree: rose },
  { name: 'amber', tree: amber },
];

/** Replace every {primitive.color.X.Y} ref with its value (leaves color-mix intact). */
function resolve(value) {
  return String(value).replace(/\{primitive\.color\.([a-z]+)\.(\d+)\}/g, (_, ramp, shade) => {
    return primitive.color?.[ramp]?.[shade]?.$value ?? 'oklch(0 0 0)';
  });
}
const v = (tree, path) => {
  let n = tree.color;
  for (const k of path) n = n?.[k];
  return n?.$value ? resolve(n.$value) : null;
};

const rows = THEMES.map(({ name, tree }) => ({
  name,
  stops: [
    { label: 'primary', value: v(tree, ['action', 'primary', 'bg']) },
    { label: 'hover', value: v(tree, ['action', 'primary-hover', 'bg']) },
    { label: 'soft', value: v(tree, ['action', 'primary-soft', 'bg']) },
    { label: 'text', value: v(tree, ['action', 'primary', 'fg']) },
    { label: 'ring', value: v(tree, ['focus-ring']) },
  ].filter((s) => s.value),
}));
---

<div class="cts not-content">
  {rows.map((row) => (
    <div class="cts__row">
      <div class="cts__name"><code>{row.name}</code></div>
      <div class="cts__stops">
        {row.stops.map((s) => (
          <div class="cts__stop">
            <span class="cts__chip" style={`background:${s.value}`} title={s.value}></span>
            <span class="cts__label">{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  ))}
</div>

<style>
  .cts { display: grid; gap: 0.75rem; margin-block: 1.5rem; }
  .cts__row { display: grid; gap: 0.4rem; }
  .cts__name code { background: transparent; padding: 0; }
  .cts__stops { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .cts__stop { display: grid; gap: 0.25rem; justify-items: center; font-size: var(--sl-text-xs); }
  .cts__chip {
    inline-size: 3.25rem; block-size: 2.25rem; border-radius: var(--hc-radius-md, 0.375rem);
    border: 1px solid var(--hc-color-border, #e5e7eb);
    background-image: linear-gradient(45deg, #ccc 25%, transparent 25%), linear-gradient(-45deg, #ccc 25%, transparent 25%), linear-gradient(45deg, transparent 75%, #ccc 75%), linear-gradient(-45deg, transparent 75%, #ccc 75%);
    background-size: 10px 10px; background-position: 0 0, 0 5px, 5px -5px, -5px 0;
  }
  .cts__label { color: var(--sl-color-gray-3); }
</style>
