---
// Starlight `Head` override.
//
// Imports `@hypermedia-components/core/behaviors` — the auto-init
// entry that calls every installer (`installConfirm`, `installToast`,
// `installCloseDialog`, `installClosePopover`, `installRemoteDialog`,
// `installTabs`) once the document is ready. This lets interactive
// docs previews actually behave on click / keyboard, not just look
// right.
//
// The CSS bundle is already wired via `customCss` in astro.config.mjs;
// this override does the same for the behaviors bundle. Both resolve
// through the pnpm workspace, so no npm publish is required.
import Default from '@astrojs/starlight/components/Head.astro';
---

<Default><slot /></Default>

<script>
  import '@hypermedia-components/core/behaviors';

  // The chart recipe is opt-in: Observable Plot is not bundled into core,
  // and installChart is not part of the auto-init behaviors entry. Load
  // Plot and install the behavior only on pages that actually use a chart,
  // so every other page stays light. Plot is bundled by Vite into a lazy
  // chunk (dynamic import) — no CDN, no CSP concerns.
  async function initCharts() {
    if (!document.querySelector('[data-hc-chart]')) return;
    const [{ installChart }, Plot] = await Promise.all([
      import('@hypermedia-components/core'),
      import('@observablehq/plot'),
    ]);
    installChart(document, { plot: Plot });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCharts, { once: true });
  } else {
    initCharts();
  }

  // Recipe demo wiring (docs-only). The toast / confirm-action recipe pages
  // show live previews; the markup there is brace-free (MDX would parse `{`
  // as JSX), so the small dispatch / result logic lives here, delegated and
  // gated on demo-specific data attributes / ids so it is inert elsewhere.

  // Toast preview: a button carrying data-toast-* fires an hc:toast.
  document.addEventListener('click', (event) => {
    const btn = event.target.closest('[data-toast-message]');
    if (!btn) return;
    document.body.dispatchEvent(new CustomEvent('hc:toast', {
      bubbles: true,
      detail: {
        title: btn.dataset.toastTitle || undefined,
        message: btn.dataset.toastMessage,
        variant: btn.dataset.toastVariant || 'info',
      },
    }));
  });

  // Confirm-action preview: surface the result (there is no server here).
  document.addEventListener('hc:confirmed', (event) => {
    if (event.target && event.target.id === 'confirm-demo-btn') {
      const out = document.getElementById('confirm-demo-out');
      if (out) out.textContent = 'Confirmed — the htmx request would fire now.';
    }
  });
</script>
