---
// Renders the primitive color palette as swatches, straight from the
// real DTCG source (primitive.tokens.json). Static — no client JS.
//
// Primitives are `emit: false`: they are NOT emitted as `--hc-*` CSS
// variables. They exist only as the raw values that token `{ref}`s resolve
// against. This page is the reference for authoring those refs (e.g. a
// custom `color.*.tokens.json` theme, or the builder's DTCG export).
import primitive from '@hypermedia-components/core/tokens/primitive.tokens.json';
import { parseOklch, toHex } from '@hypermedia-components/core/oklch';

const color = primitive.color ?? {};

/**
 * Pick black/white label text for legibility.
 *
 * OKLCH lightness *is* perceptual lightness, so the choice is a single
 * threshold rather than a luminance calculation. 0.55 is the measured
 * crossover where white text stops clearing 4.5:1 on the most demanding
 * hue, and black text starts clearing it — the same pivot the token
 * layer uses to pick `action.primary.fg`.
 */
function readableOn(value) {
  const parsed = parseOklch(value);
  return (parsed?.L ?? 1) > 0.55 ? '#000' : '#fff';
}

const SHADES = ['50', '100', '200', '300', '350', '400', '500', '600', '700', '800', '900', '950'];

function ramp(name) {
  const node = color[name];
  if (!node) return null;
  const stops = SHADES.filter((s) => node[s]?.$value).map((s) => ({ shade: s, value: node[s].$value }));
  return stops.length ? { name, stops } : null;
}

const NEUTRALS = ['gray', 'slate', 'zinc', 'neutral', 'stone'].map(ramp).filter(Boolean);
const ACCENTS = ['blue', 'indigo', 'violet', 'rose', 'red', 'amber', 'green'].map(ramp).filter(Boolean);
const BASE = ['white', 'black']
  .filter((n) => color[n]?.$value)
  .map((n) => ({ name: n, value: color[n].$value }));

const groups = [
  { title: 'Neutrals', ramps: NEUTRALS },
  { title: 'Accent & status hues', ramps: ACCENTS },
];
---

<div class="pal not-content">
  {BASE.length > 0 && (
    <div class="pal__base">
      {BASE.map((b) => (
        <span class="pal__chip" style={`background:${b.value};color:${readableOn(b.value)}`}>
          {b.name} <code>{b.value}</code>
        </span>
      ))}
    </div>
  )}

  {groups.map((g) => (
    <section class="pal__group">
      <h3 class="pal__grouptitle">{g.title}</h3>
      {g.ramps.map((r) => (
        <div class="pal__ramp">
          <div class="pal__rampname"><code>color.{r.name}</code></div>
          <div class="pal__stops" style={`--pal-cols:${r.stops.length}`}>
            {r.stops.map((s) => (
              <div class="pal__stop" style={`background:${s.value};color:${readableOn(s.value)}`}
                   title={`{primitive.color.${r.name}.${s.shade}} = ${s.value}`}>
                <span class="pal__shade">{s.shade}</span>
                <span class="pal__hex">{toHex(s.value)}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </section>
  ))}
</div>

<style>
  .pal { display: grid; gap: 2rem; margin-block: 1.5rem; }
  .pal__base { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .pal__chip {
    display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.45rem 0.7rem;
    border-radius: var(--hc-radius-md, 0.375rem); border: 1px solid var(--hc-color-border, #e5e7eb);
    font-size: var(--sl-text-xs); text-transform: capitalize;
  }
  .pal__chip code { background: transparent; color: inherit; font-size: 0.8em; }
  .pal__group { display: grid; gap: 0.75rem; }
  .pal__grouptitle { margin: 0; font-size: var(--sl-text-lg); }
  .pal__ramp { display: grid; gap: 0.3rem; }
  .pal__rampname { font-size: var(--sl-text-sm); }
  .pal__rampname code { background: transparent; padding: 0; }
  .pal__stops { display: grid; grid-template-columns: repeat(var(--pal-cols, 11), 1fr); gap: 2px; }
  @media (max-width: 50rem) { .pal__stops { grid-template-columns: repeat(6, 1fr); } }
  .pal__stop {
    display: flex; flex-direction: column; gap: 0.1rem; justify-content: flex-end;
    min-block-size: 3.5rem; padding: 0.35rem 0.4rem; border-radius: 4px;
    font-size: 0.62rem; line-height: 1.2; overflow: hidden;
  }
  .pal__shade { font-weight: 700; }
  .pal__hex { opacity: 0.85; font-variant-numeric: tabular-nums; }
</style>
