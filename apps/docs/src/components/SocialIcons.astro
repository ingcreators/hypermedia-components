---
// Starlight `SocialIcons` override.
//
// Renders Starlight's default icons (the GitHub link from
// `social: {github: ...}` in astro.config.mjs) and appends two
// pickers so visitors can preview every component / recipe at any
// of the Hypermedia Components density tiers and color themes.
// Both choices are persisted to localStorage; an inline head script
// (see astro.config.mjs) applies them before first paint so there
// is no flash for repeat visitors.
//
// Light / dark theme switching is owned by Starlight's own picker:
// both Starlight and HC tokens read `data-theme` on `<html>`, so
// the cascade is automatic — no extra wiring needed.
import Default from '@astrojs/starlight/components/SocialIcons.astro';
---

<Default><slot /></Default>

<label class="hc-picker" aria-label="Color theme">
  <span class="hc-picker__label">Color</span>
  <select id="hc-color-select" class="hc-select" data-size="sm" aria-label="Color theme">
    <option value="default">Default</option>
    <option value="indigo">Indigo</option>
    <option value="emerald">Emerald</option>
    <option value="rose">Rose</option>
    <option value="amber">Amber</option>
  </select>
</label>

<label class="hc-picker" aria-label="Neutral ramp">
  <span class="hc-picker__label">Neutral</span>
  <select id="hc-neutral-select" class="hc-select" data-size="sm" aria-label="Neutral ramp">
    <option value="gray">Gray</option>
    <option value="slate">Slate</option>
    <option value="zinc">Zinc</option>
    <option value="neutral">Neutral</option>
    <option value="stone">Stone</option>
  </select>
</label>

<label class="hc-picker" aria-label="Density">
  <span class="hc-picker__label">Density</span>
  <select id="hc-density-select" class="hc-select" data-size="sm" aria-label="Density">
    <option value="comfortable">Comfortable</option>
    <option value="compact">Compact</option>
    <option value="dense">Dense</option>
  </select>
</label>

<label class="hc-picker" aria-label="Text direction">
  <span class="hc-picker__label">Dir</span>
  <select id="hc-dir-select" class="hc-select" data-size="sm" aria-label="Text direction">
    <option value="ltr">LTR</option>
    <option value="rtl">RTL</option>
  </select>
</label>

<script>
  /** @type {Array<{ key: string, attr: string, values: string[], fallback: string, id: string }>} */
  const PICKERS = [
    { key: 'hc-density', attr: 'data-density', values: ['comfortable', 'compact', 'dense'], fallback: 'comfortable', id: 'hc-density-select' },
    { key: 'hc-color',   attr: 'data-color',   values: ['default', 'indigo', 'emerald', 'rose', 'amber'], fallback: 'default', id: 'hc-color-select' },
    { key: 'hc-neutral', attr: 'data-neutral', values: ['gray', 'slate', 'zinc', 'neutral', 'stone'], fallback: 'gray', id: 'hc-neutral-select' },
    { key: 'hc-dir',     attr: 'dir',          values: ['ltr', 'rtl'], fallback: 'ltr', id: 'hc-dir-select' },
  ];

  for (const p of PICKERS) {
    /** @returns {string} */
    const read = () => {
      try {
        const v = localStorage.getItem(p.key);
        return p.values.includes(v) ? v : p.fallback;
      } catch {
        return p.fallback;
      }
    };

    /** @param {string} v */
    const apply = (v) => document.documentElement.setAttribute(p.attr, v);

    const init = () => {
      const current = read();
      apply(current);
      const select = document.getElementById(p.id);
      if (!(select instanceof HTMLSelectElement)) return;
      select.value = current;
      select.addEventListener('change', () => {
        apply(select.value);
        try { localStorage.setItem(p.key, select.value); } catch {}
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
      init();
    }
  }
</script>

<style>
  .hc-picker {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-inline-start: 0.5rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-2);
  }

  .hc-picker__label {
    /* Hide the visible label on narrow viewports — each select has
       its own aria-label, so AT users still get the affordance. */
    display: none;
  }

  @media (min-width: 64rem) {
    .hc-picker__label {
      display: inline;
    }
  }

  /* The selects are dogfooded through HC's own `.hc-select` (chrome,
     chevron, focus ring, sizing all come from the component). The only
     override is layout: `.hc-select` is display:block / inline-size:100%
     by default, which we don't want in a compact inline navbar. */
  #hc-density-select,
  #hc-color-select,
  #hc-neutral-select,
  #hc-dir-select {
    inline-size: auto;
  }
</style>
