---
// Starlight `SocialIcons` override.
//
// Renders Starlight's default icons (the GitHub link from
// `social: {github: ...}` in astro.config.mjs) and appends one
// compact **Display settings** popover hosting the Hypermedia
// Components preview pickers (color / neutral / density / dir).
// They used to sit inline in the header, which crowded it enough to
// truncate the site title even on desktop; a single icon trigger
// keeps the brand readable and dogfoods `hc-popover` while at it.
//
// Every choice is persisted to localStorage; an inline head script
// (see astro.config.mjs) applies them before first paint so there is
// no flash for repeat visitors.
//
// Light / dark theme switching is owned by Starlight's own picker:
// both Starlight and HC tokens read `data-theme` on `<html>`, so the
// cascade is automatic — no extra wiring needed.
import Default from '@astrojs/starlight/components/SocialIcons.astro';

const isJa = Astro.url.pathname.includes('/ja/');
const settingsLabel = isJa ? '表示設定' : 'Display settings';

// Starlight renders SocialIcons TWICE per page (desktop header +
// mobile menu), so every id here must be per-instance: fixed ids
// duplicated on every page, and only the first instance's popover /
// selects worked — the mobile pickers were dead. The popover id is
// uniqued per render; the selects need no ids at all (the labels wrap
// them), and the script binds by class + data-pref instead of ids.
const uid = 'hc-display-settings-' + Math.random().toString(36).slice(2, 8);
---

<Default><slot /></Default>

<button
  class="hc-button hc-display-settings-trigger"
  type="button"
  data-variant="ghost"
  data-size="sm"
  popovertarget={uid}
  aria-label={settingsLabel}
  title={settingsLabel}>
  <!-- "sliders" glyph — decorative; the accessible name is the aria-label. -->
  <svg
    aria-hidden="true"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round">
    <line x1="4" y1="6" x2="20" y2="6"></line>
    <circle cx="9" cy="6" r="2.25" fill="var(--sl-color-bg-nav, canvas)"></circle>
    <line x1="4" y1="12" x2="20" y2="12"></line>
    <circle cx="15" cy="12" r="2.25" fill="var(--sl-color-bg-nav, canvas)"></circle>
    <line x1="4" y1="18" x2="20" y2="18"></line>
    <circle cx="7" cy="18" r="2.25" fill="var(--sl-color-bg-nav, canvas)"></circle>
  </svg>
</button>

<div
  id={uid}
  class="hc-popover hc-display-settings"
  popover
  data-side="bottom"
  data-align="end"
  aria-label={settingsLabel}>
  <p class="hc-display-settings__title">{settingsLabel}</p>

  <label class="hc-picker">
    <span class="hc-picker__label">Color</span>
    <select class="hc-select" data-size="sm" data-pref="hc-color">
      <option value="default">Default</option>
      <option value="teal">Teal</option>
      <option value="lime">Lime</option>
      <option value="orange">Orange</option>
      <option value="fuchsia">Fuchsia</option>
    </select>
  </label>

  <label class="hc-picker">
    <span class="hc-picker__label">Neutral</span>
    <select class="hc-select" data-size="sm" data-pref="hc-neutral">
      <option value="gray">Gray</option>
      <option value="slate">Slate</option>
      <option value="zinc">Zinc</option>
      <option value="neutral">Neutral</option>
      <option value="stone">Stone</option>
    </select>
  </label>

  <label class="hc-picker">
    <span class="hc-picker__label">Density</span>
    <select class="hc-select" data-size="sm" data-pref="hc-density">
      <option value="comfortable">Comfortable</option>
      <option value="compact">Compact</option>
      <option value="dense">Dense</option>
    </select>
  </label>

  <label class="hc-picker">
    <span class="hc-picker__label">Dir</span>
    <select class="hc-select" data-size="sm" data-pref="hc-dir">
      <option value="ltr">LTR</option>
      <option value="rtl">RTL</option>
    </select>
  </label>
</div>

<script>
  // Astro dedupes and runs this module once per page, but the markup
  // above renders twice (header + mobile menu) — so bind every select
  // by its data-pref key, and keep the instances in sync: changing a
  // picker in one place updates its twin in the other.
  /** @type {Array<{ key: string, attr: string, values: string[], fallback: string }>} */
  const PICKERS = [
    { key: 'hc-density', attr: 'data-density', values: ['comfortable', 'compact', 'dense'], fallback: 'comfortable' },
    { key: 'hc-color',   attr: 'data-color',   values: ['default', 'teal', 'lime', 'orange', 'fuchsia'], fallback: 'default' },
    { key: 'hc-neutral', attr: 'data-neutral', values: ['gray', 'slate', 'zinc', 'neutral', 'stone'], fallback: 'gray' },
    { key: 'hc-dir',     attr: 'dir',          values: ['ltr', 'rtl'], fallback: 'ltr' },
  ];

  for (const p of PICKERS) {
    /** @returns {string} */
    const read = () => {
      try {
        const v = localStorage.getItem(p.key);
        return p.values.includes(v) ? v : p.fallback;
      } catch {
        return p.fallback;
      }
    };

    /** @param {string} v */
    const apply = (v) => document.documentElement.setAttribute(p.attr, v);

    const init = () => {
      const current = read();
      apply(current);
      const selects = /** @type {HTMLSelectElement[]} */ ([
        ...document.querySelectorAll(`.hc-display-settings select[data-pref="${p.key}"]`),
      ]);
      for (const select of selects) {
        select.value = current;
        select.addEventListener('change', () => {
          apply(select.value);
          for (const twin of selects) twin.value = select.value;
          try { localStorage.setItem(p.key, select.value); } catch {}
        });
      }
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
      init();
    }
  }
</script>

<style>
  .hc-display-settings-trigger {
    margin-inline-start: 0.25rem;
    color: var(--sl-color-gray-2);
  }

  .hc-display-settings {
    min-inline-size: 15rem;
    gap: 0.625rem;
  }

  .hc-display-settings:popover-open {
    display: grid;
  }

  .hc-display-settings__title {
    margin: 0;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    color: var(--sl-color-gray-2);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .hc-picker {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
</style>
