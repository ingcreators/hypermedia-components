---
// Starlight `SocialIcons` override.
//
// Renders Starlight's default icons (the GitHub link from
// `social: {github: ...}` in astro.config.mjs) and appends one
// compact **Display settings** popover hosting the Hypermedia
// Components preview pickers (color / neutral / density / dir).
// They used to sit inline in the header, which crowded it enough to
// truncate the site title even on desktop; a single icon trigger
// keeps the brand readable and dogfoods `hc-popover` while at it.
//
// Every choice is persisted to localStorage; an inline head script
// (see astro.config.mjs) applies them before first paint so there is
// no flash for repeat visitors.
//
// Light / dark theme switching is owned by Starlight's own picker:
// both Starlight and HC tokens read `data-theme` on `<html>`, so the
// cascade is automatic — no extra wiring needed.
import Default from '@astrojs/starlight/components/SocialIcons.astro';

const isJa = Astro.url.pathname.includes('/ja/');
const settingsLabel = isJa ? '表示設定' : 'Display settings';
---

<Default><slot /></Default>

<button
  class="hc-button hc-display-settings-trigger"
  type="button"
  data-variant="ghost"
  data-size="sm"
  popovertarget="hc-display-settings"
  aria-label={settingsLabel}
  title={settingsLabel}>
  <!-- "sliders" glyph — decorative; the accessible name is the aria-label. -->
  <svg
    aria-hidden="true"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round">
    <line x1="4" y1="6" x2="20" y2="6"></line>
    <circle cx="9" cy="6" r="2.25" fill="var(--sl-color-bg-nav, canvas)"></circle>
    <line x1="4" y1="12" x2="20" y2="12"></line>
    <circle cx="15" cy="12" r="2.25" fill="var(--sl-color-bg-nav, canvas)"></circle>
    <line x1="4" y1="18" x2="20" y2="18"></line>
    <circle cx="7" cy="18" r="2.25" fill="var(--sl-color-bg-nav, canvas)"></circle>
  </svg>
</button>

<div
  id="hc-display-settings"
  class="hc-popover hc-display-settings"
  popover
  data-side="bottom"
  data-align="end"
  aria-label={settingsLabel}>
  <p class="hc-display-settings__title">{settingsLabel}</p>

  <label class="hc-picker" for="hc-color-select">
    <span class="hc-picker__label">Color</span>
    <select id="hc-color-select" class="hc-select" data-size="sm">
      <option value="default">Default</option>
      <option value="indigo">Indigo</option>
      <option value="emerald">Emerald</option>
      <option value="rose">Rose</option>
      <option value="amber">Amber</option>
    </select>
  </label>

  <label class="hc-picker" for="hc-neutral-select">
    <span class="hc-picker__label">Neutral</span>
    <select id="hc-neutral-select" class="hc-select" data-size="sm">
      <option value="gray">Gray</option>
      <option value="slate">Slate</option>
      <option value="zinc">Zinc</option>
      <option value="neutral">Neutral</option>
      <option value="stone">Stone</option>
    </select>
  </label>

  <label class="hc-picker" for="hc-density-select">
    <span class="hc-picker__label">Density</span>
    <select id="hc-density-select" class="hc-select" data-size="sm">
      <option value="comfortable">Comfortable</option>
      <option value="compact">Compact</option>
      <option value="dense">Dense</option>
    </select>
  </label>

  <label class="hc-picker" for="hc-dir-select">
    <span class="hc-picker__label">Dir</span>
    <select id="hc-dir-select" class="hc-select" data-size="sm">
      <option value="ltr">LTR</option>
      <option value="rtl">RTL</option>
    </select>
  </label>
</div>

<script>
  /** @type {Array<{ key: string, attr: string, values: string[], fallback: string, id: string }>} */
  const PICKERS = [
    { key: 'hc-density', attr: 'data-density', values: ['comfortable', 'compact', 'dense'], fallback: 'comfortable', id: 'hc-density-select' },
    { key: 'hc-color',   attr: 'data-color',   values: ['default', 'indigo', 'emerald', 'rose', 'amber'], fallback: 'default', id: 'hc-color-select' },
    { key: 'hc-neutral', attr: 'data-neutral', values: ['gray', 'slate', 'zinc', 'neutral', 'stone'], fallback: 'gray', id: 'hc-neutral-select' },
    { key: 'hc-dir',     attr: 'dir',          values: ['ltr', 'rtl'], fallback: 'ltr', id: 'hc-dir-select' },
  ];

  for (const p of PICKERS) {
    /** @returns {string} */
    const read = () => {
      try {
        const v = localStorage.getItem(p.key);
        return p.values.includes(v) ? v : p.fallback;
      } catch {
        return p.fallback;
      }
    };

    /** @param {string} v */
    const apply = (v) => document.documentElement.setAttribute(p.attr, v);

    const init = () => {
      const current = read();
      apply(current);
      const select = document.getElementById(p.id);
      if (!(select instanceof HTMLSelectElement)) return;
      select.value = current;
      select.addEventListener('change', () => {
        apply(select.value);
        try { localStorage.setItem(p.key, select.value); } catch {}
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
      init();
    }
  }
</script>

<style>
  .hc-display-settings-trigger {
    margin-inline-start: 0.25rem;
    color: var(--sl-color-gray-2);
  }

  .hc-display-settings {
    min-inline-size: 15rem;
    gap: 0.625rem;
  }

  .hc-display-settings:popover-open {
    display: grid;
  }

  .hc-display-settings__title {
    margin: 0;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    color: var(--sl-color-gray-2);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .hc-picker {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
</style>
