# Cloudflare Pages response headers for the Starlight docs.
#
# Headers are applied in order; later rules layer on top of earlier
# ones. Astro's `_astro/` outputs are content-hashed, so they can be
# cached aggressively; HTML must stay revalidated so navigation keeps
# pace with the deployed build.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/hypermedia-components/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/pagefind/*
  Cache-Control: public, max-age=86400

/hypermedia-components/pagefind/*
  Cache-Control: public, max-age=86400

/*.html
  Cache-Control: public, max-age=0, must-revalidate
